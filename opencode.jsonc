{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Projects\\alvorada",
      ],
      "enabled": true,
    },
    "git": {
      "type": "local",
      "command": ["bunx", "-y", "git-mcp"],
      "enabled": true,
    },
    "playwright": {
      "type": "local",
      "command": ["bunx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
    "sequential": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking",
      ],
      "enabled": true,
    },
  },
}
