{
  "name": "solarisael",
  "version": "0.1.0",
  "description": "sun + aris + aleph + el — the being placed within the divine architecture",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "serve": "astro dev --host 127.0.0.1 --port 4322 --strictPort",
    "serve:start": "bun scripts/dev_server.js start",
    "serve:wait": "bun scripts/dev_server.js wait",
    "serve:stop": "bun scripts/dev_server.js stop",
    "serve:status": "bun scripts/dev_server.js status",
    "serve:check": "bun scripts/dev_server.js check",
    "build": "astro build",
    "preview": "astro preview",
    "test": "bun test",
    "new:post": "bun scripts/new_post.js",
    "css:size:audit": "bun scripts/css_size_audit.js check --scope=priority-a",
    "rubedo:scenes:check": "bun scripts/rubedo_scene_identity_audit.js check",
    "css:ornaments:check": "bun scripts/css_ornaments_audit.js check",
    "css:bg-stack:check": "bun scripts/css_background_stack_audit.js check",
    "css:hard-gates:check": "bun run css:ornaments:check && bun run css:bg-stack:check",
    "css:tunables:check": "bun scripts/css_tunables.js check src/styles/components/mobile_nav.css --selector=#sol_mobile_nav --prefix=mobile_ --ignore=mobile_neon_color",
    "css:tunables:sync": "bun scripts/css_tunables.js sync src/styles/components/mobile_nav.css --selector=#sol_mobile_nav --prefix=mobile_ --ignore=mobile_neon_color"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/virtual-core": "^3.16.0",
    "astro": "^5.16.11",
    "htmx.org": "^2.0.8",
    "idiomorph": "^0.7.4",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "vite": "^7.3.1"
  }
}
