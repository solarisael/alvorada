---
import ContentLink from "../page/content_link.astro";

const { books = [], empty_text = "No works published yet." } = Astro.props;

const book_actions = (book) =>
  [
    { label: "read", href: book.reader_href },
    { label: "constellation", href: book.timeline_href },
  ].filter((action) => action.href);
---

{
  books.length === 0 ? (
    <p class="sol__rubedo_empty">{empty_text}</p>
  ) : (
    <rubedo data-shape="book_grid" class="sol__rubedo_book_grid">
      {books.map((book) => (
        <rubedo data-shape="book_card" class="sol__rubedo_book_card">
          <article class="sol__rubedo_book_card_inner">
            <header class="sol__rubedo_book_card_head">
              <ContentLink href={book.book_href} class="sol__rubedo_book_title">
                {book.book_title}
              </ContentLink>
              {book.synopsis && (
                <p class="sol__rubedo_book_synopsis">{book.synopsis}</p>
              )}
              <span class="sol__rubedo_book_count sol__text_kicker">
                {book.chapter_count}{" "}
                {book.chapter_count === 1 ? "chapter" : "chapters"}
              </span>
            </header>

            <footer class="sol__rubedo_book_actions">
              {book_actions(book).map((action) => (
                <ContentLink
                  href={action.href}
                  class="sol__rubedo_book_action sol__text_kicker"
                >
                  {action.label}
                </ContentLink>
              ))}
            </footer>
          </article>
        </rubedo>
      ))}
    </rubedo>
  )
}
