---
const { book_slug, timeline_data_href } = Astro.props;
---

<rubedo
  data-shape="timeline_interactive"
  id="sol_rubedo_timeline_interactive"
  class="sol__rubedo_timeline_interactive"
  data-book-slug={book_slug}
  data-timeline-data-href={timeline_data_href}
>
  <canvas
    id="sol_rubedo_timeline_canvas"
    class="sol__rubedo_timeline_canvas"
    tabindex="0"></canvas>

  <div
    id="sol_rubedo_timeline_hover_preview"
    class="sol__rubedo_timeline_hover_preview"
  >
  </div>

  <ul class="sol__rubedo_timeline_legend">
    <li>white path — cinza thread</li>
    <li>green path — suul thread</li>
    <li>orange path — solarisael thread</li>
    <li>dashed path — optional branch</li>
    <li>bright sigil — active chapter</li>
  </ul>
</rubedo>
