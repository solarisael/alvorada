---
import { with_base } from "../../utils/routes.js";

const {
  book_slug,
  chapter_slug,
  thread_keys = [],
  active_thread_key = "cinza",
  inert_active = false,
} = Astro.props;
---

<mantle
  data-shape="eyes_nav"
  class="sol__chapter_eyes_nav"
  data-chapter-slug={chapter_slug}
  data-book-slug={book_slug}
  data-active-thread={active_thread_key}
>
  {
    thread_keys.map((slot_thread_key) => {
      const is_active = slot_thread_key === active_thread_key;
      const slot_href = with_base(
        `/rubedo/${book_slug}/${slot_thread_key}/${chapter_slug}`,
      );
      const should_disable = inert_active && is_active;

      return (
        <a
          class="sol__chapter_eyes_slot"
          data-thread-key={slot_thread_key}
          data-thread-locked="false"
          aria-current={should_disable ? "page" : undefined}
          href={should_disable ? undefined : slot_href}
          hx-get={should_disable ? undefined : slot_href}
          hx-target={should_disable ? undefined : "#sol_content"}
          hx-select={should_disable ? undefined : "#sol_content"}
          hx-swap={should_disable ? undefined : "morph swap:220ms settle:260ms"}
        >
          {slot_thread_key}
        </a>
      );
    })
  }
</mantle>
