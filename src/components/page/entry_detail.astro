---
const { title, published_at = "", lead = "" } = Astro.props;
---

<div class="sol__entry_header">
  <h1>{title}</h1>
  {
    published_at && (
      <time datetime={published_at} class="sol__text_kicker">
        {published_at}
      </time>
    )
  }
  {lead && <p class="sol__text_lead">{lead}</p>}
</div>

<div class="sol__entry_body sol__chapter_content">
  <slot />
</div>
