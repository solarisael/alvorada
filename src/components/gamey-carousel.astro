---
const base_url = import.meta.env.BASE_URL;
---

<style>
  @reference "tailwindcss";

  #eyes {
    img {
      @apply object-cover;
      @apply w-full;
    }

    > div > div {
      &.active {
        @apply scale-125;
      }
    }
  }

  #lenses {
    @apply absolute z-10 cursor-none;
    @apply scale-150;
    @apply rounded-full;
    pointer-events: none;
  }
</style>

<div
  id="eyes"
  data-current="0"
  data-items="0"
  data-offset="1"
  class="relative mx-8 flex h-24 w-12 max-w-full items-center justify-center"
>
  <button
    class="text-ctp-base bg-ctp-lavender-50 absolute -left-1 z-10 flex h-4 w-4 items-center justify-center rounded-full pb-0.5 text-4xl leading-6"
    >‹</button
  >

  <div class="absolute flex h-12 flex-nowrap items-center gap-4">
    <!-- slides start -->
    <div class="w-full shrink-0 overflow-hidden rounded-full">
      <img src={`${base_url}images/sol-curr.jpg`} alt="" />
    </div>
    <div class="w-full shrink-0 overflow-hidden rounded-full">
      <img src={`${base_url}images/sol-curr.jpg`} alt="" />
    </div>
    <div class="w-full shrink-0 overflow-hidden rounded-full">
      <img src={`${base_url}images/sol-curr.jpg`} alt="" />
    </div>
    <!-- slides end -->
  </div>

  <div id="lenses" class="border-ctp-blue-50 h-12 w-12 border-2"></div>

  <button
    class="text-ctp-base bg-ctp-lavender-50 absolute -right-1 z-10 flex h-4 w-4 items-center justify-center rounded-full pb-0.5 text-4xl leading-6"
    >›</button
  >
</div>

