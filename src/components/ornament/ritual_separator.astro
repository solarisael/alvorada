---
import "../../styles/components/ritual_separator.css";
import { with_base } from "../../utils/routes.js";

const divider_src = with_base("ornaments/reliquary/divider_center.svg");
---

<div class="sol__ritual_separator" aria-hidden="true">
  <span class="sol__ritual_separator_line"></span>
  <svg class="sol__ritual_separator_sigil" viewBox="0 0 48 24">
    <use href={`${divider_src}#reliquary-divider-center`}></use>
  </svg>
  <span class="sol__ritual_separator_line"></span>
</div>
