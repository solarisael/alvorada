---
// Decorative SVG frame for the content shell — corners, lines, sigils.
// Reliquary set (Kintsu pass-1, 2026-05-14): single corner SVG rotated per-position,
// divider_flourish for lines, sigil_concentric for top sigil, divider_center for bottom.
// Sol-mythology weaving (black sun / wolf skull / Perseus) is the next iteration.
// Preserves the sol__content_layer class so the .sol__content_layer positioning rules still apply.

import { with_base } from "../../utils/routes.js";

const reliquary_corner = with_base("ornaments/reliquary/card_corner.svg");
const reliquary_sigil = with_base("ornaments/reliquary/sigil_concentric.svg");
const reliquary_center = with_base("ornaments/reliquary/divider_center.svg");
const reliquary_flourish = with_base(
  "ornaments/reliquary/divider_flourish.svg",
);
---

<div
  class="sol__content_layer sol__content_layer_ornament_svg sol__ornament_layer sol__ornament_layer_fill"
  aria-hidden="true"
>
  <ornament data-shape="content_frame" class="sol__ornament_holder">
    <img
      class="sol__ornament_item sol__content_ornament sol__content_ornament_corner_tl"
      src={reliquary_corner}
      alt=""
    />
    <img
      class="sol__ornament_item sol__content_ornament sol__content_ornament_corner_tr"
      src={reliquary_corner}
      alt=""
    />
    <img
      class="sol__ornament_item sol__content_ornament sol__content_ornament_corner_bl"
      src={reliquary_corner}
      alt=""
    />
    <img
      class="sol__ornament_item sol__content_ornament sol__content_ornament_corner_br"
      src={reliquary_corner}
      alt=""
    />
    <div
      class="sol__ornament_item sol__content_ornament sol__content_ornament_line_top"
    >
      <svg
        class="sol__content_ornament_line_flourish_start"
        viewBox="0 0 44 14"
        aria-hidden="true"
      >
        <use href={`${reliquary_flourish}#reliquary-divider-flourish`}></use>
      </svg>
      <div class="sol__content_ornament_line_bar"></div>
      <svg
        class="sol__content_ornament_line_flourish_end"
        viewBox="0 0 44 14"
        aria-hidden="true"
      >
        <use href={`${reliquary_flourish}#reliquary-divider-flourish`}></use>
      </svg>
    </div>
    <div
      class="sol__ornament_item sol__content_ornament sol__content_ornament_line_bottom"
    >
      <svg
        class="sol__content_ornament_line_flourish_start"
        viewBox="0 0 44 14"
        aria-hidden="true"
      >
        <use href={`${reliquary_flourish}#reliquary-divider-flourish`}></use>
      </svg>
      <div class="sol__content_ornament_line_bar"></div>
      <svg
        class="sol__content_ornament_line_flourish_end"
        viewBox="0 0 44 14"
        aria-hidden="true"
      >
        <use href={`${reliquary_flourish}#reliquary-divider-flourish`}></use>
      </svg>
    </div>
    <svg
      class="sol__ornament_item sol__content_ornament sol__content_ornament_sigil_top"
      viewBox="0 0 48 48"
      aria-hidden="true"
    >
      <use href={`${reliquary_sigil}#reliquary-sigil-concentric`}></use>
    </svg>
    <svg
      class="sol__ornament_item sol__content_ornament sol__content_ornament_sigil_bottom"
      viewBox="0 0 48 24"
      aria-hidden="true"
    >
      <use href={`${reliquary_center}#reliquary-divider-center`}></use>
    </svg>
  </ornament>
</div>
