---
import { with_base } from "../../utils/routes.js";

const corner = with_base("ornaments/reliquary/card_corner.svg");
const crest_top = with_base("ornaments/reliquary/sigil_concentric.svg");
const crest_bottom = with_base("ornaments/reliquary/divider_center.svg");
const side_flourish = with_base("ornaments/reliquary/divider_flourish.svg");
---

<ornament
  aria-hidden="true"
  data-shape="reading_frame"
  class="sol__reading_frame_ornaments"
>
  <img
    class="sol__reading_frame_ornament sol__reading_frame_corner_tl"
    src={corner}
    alt=""
  />
  <img
    class="sol__reading_frame_ornament sol__reading_frame_corner_tr"
    src={corner}
    alt=""
  />
  <img
    class="sol__reading_frame_ornament sol__reading_frame_corner_bl"
    src={corner}
    alt=""
  />
  <img
    class="sol__reading_frame_ornament sol__reading_frame_corner_br"
    src={corner}
    alt=""
  />
  <svg
    class="sol__reading_frame_ornament sol__reading_frame_crest_top"
    viewBox="0 0 48 48"
    aria-hidden="true"
  >
    <use href={`${crest_top}#reliquary-sigil-concentric`}></use>
  </svg>
  <svg
    class="sol__reading_frame_ornament sol__reading_frame_crest_bottom"
    viewBox="0 0 48 24"
    aria-hidden="true"
  >
    <use href={`${crest_bottom}#reliquary-divider-center`}></use>
  </svg>
  <svg
    class="sol__reading_frame_ornament sol__reading_frame_flourish_left"
    viewBox="0 0 44 14"
    aria-hidden="true"
  >
    <use href={`${side_flourish}#reliquary-divider-flourish`}></use>
  </svg>
  <svg
    class="sol__reading_frame_ornament sol__reading_frame_flourish_right"
    viewBox="0 0 44 14"
    aria-hidden="true"
  >
    <use href={`${side_flourish}#reliquary-divider-flourish`}></use>
  </svg>
</ornament>
