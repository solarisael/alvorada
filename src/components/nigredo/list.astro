---
/**
 * NigredoList — virtual feed shell.
 * Astro emits one inert template per entry plus precomputed size/data payloads;
 * the client only windows, filters, and expands.
 */

import EntryRow from "./entry_row.astro";
import { NIGREDO_CONTAINERS } from "../../data/nigredo_taxonomy.js";
import { with_base } from "../../utils/routes.js";

const { archive_index = [] } = Astro.props;
const INITIAL_ENTRY_COUNT = 5;

const ornament_srcs = {
  corner_tl: with_base("ornaments/cinza/card_corner_a.svg"),
  corner_tr: with_base("ornaments/cinza/card_corner_b.svg"),
  corner_bl: with_base("ornaments/cinza/card_corner_c.svg"),
  corner_br: with_base("ornaments/cinza/card_corner_d.svg"),
};

const virtual_entries = archive_index.map(({ Content, ...entry }, index) => ({
  ...entry,
  index,
  key: `${entry.slug}:${index}`,
}));
const initial_entries = archive_index.slice(0, INITIAL_ENTRY_COUNT);
---

<nigredo data-shape="list" class="sol__nigredo_archive" data-nigredo-archive>
  <!-- Filter block: party_roster outer vessel -->
  <div class="sol__nigredo_filter_block" data-nigredo-filter-rail>
    <!-- Header row: label + clear -->
    <div class="sol__nigredo_filter_header">
      <span class="sol__nigredo_filter_title">afflictions</span>
      <button
        class="sol__nigredo_filter_clear sol__text_kicker"
        data-nigredo-filter-clear
        type="button"
        hidden>clear</button
      >
    </div>

    <!-- Inner field: status_effects grouped into fire containers. -->
    <div class="sol__nigredo_filter_field">
      <div class="sol__nigredo_filter_groups">
        {
          NIGREDO_CONTAINERS.map((container) => (
            <div
              class="sol__nigredo_filter_group"
              data-container={container.key}
            >
              <button
                class="sol__nigredo_filter_group_label"
                data-filter-container={container.key}
                data-active="false"
                type="button"
                aria-pressed="false"
                aria-label={`toggle ${container.label} afflictions`}
              >
                {container.label}
              </button>
              <div class="sol__nigredo_filter_pills">
                {container.states.map((state) => (
                  <button
                    class="sol__nigredo_filter_btn sol__nigredo_pill"
                    data-filter-state={state.key}
                    data-container={container.key}
                    data-active="false"
                    type="button"
                    title={state.gloss || undefined}
                  >
                    {state.label}
                  </button>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Status row -->
  <div class="sol__nigredo_archive_status">
    <span
      class="sol__nigredo_archive_count sol__text_kicker"
      data-nigredo-count
    >
      {archive_index.length}
    </span>
    <span class="sol__nigredo_archive_count_label sol__text_kicker"
      >fragments</span
    >
    <span
      class="sol__nigredo_archive_filter_summary sol__text_kicker"
      data-nigredo-filter-summary
      hidden></span>
  </div>

  <!-- Feed pane: window-scrolled virtual track. -->
  <div class="sol__nigredo_scroll_pane" data-nigredo-scroll>
    <div class="sol__nigredo_inner_track" data-nigredo-inner>
      <ol class="sol__nigredo_list" data-nigredo-list>
        {
          initial_entries.map((entry, index) => (
            <EntryRow
              entry={entry}
              index={index}
              ornament_srcs={ornament_srcs}
              prerendered
            />
          ))
        }
      </ol>
    </div>
  </div>
</nigredo>

<script
  id="sol_nigredo_archive_index"
  type="application/json"
  set:html={JSON.stringify(virtual_entries)}
/>

{
  archive_index.map((entry, index) => (
    <template data-nigredo-entry-template data-index={index}>
      <EntryRow entry={entry} index={index} ornament_srcs={ornament_srcs} />
    </template>
  ))
}

<noscript>
  <ol class="sol__nigredo_list sol__nigredo_list_fallback">
    {
      archive_index.slice(0, 12).map((entry) => (
        <li>
          <a href={entry.href}>{entry.display_title}</a>
        </li>
      ))
    }
  </ol>
</noscript>

<script>
  import { init_nigredo_archive } from "../../scripts/nigredo_archive.js";
  init_nigredo_archive();
</script>
