---
/**
 * NigredoList — virtual feed shell.
 * Astro emits one inert template per entry plus precomputed size/data payloads;
 * the client only windows, filters, and expands.
 */

import ContentLink from "../page/content_link.astro";
import {
  NIGREDO_CONTAINERS,
  NIGREDO_STATE_TO_CONTAINER,
  NIGREDO_STATE_LABEL,
  NIGREDO_STATE_GLOSS,
} from "../../data/nigredo_taxonomy.js";
import { with_base } from "../../utils/routes.js";

const { archive_index = [] } = Astro.props;

const ornament_srcs = {
  corner_tl: with_base("ornaments/cinza/card_corner_a.svg"),
  corner_tr: with_base("ornaments/cinza/card_corner_b.svg"),
  corner_bl: with_base("ornaments/cinza/card_corner_c.svg"),
  corner_br: with_base("ornaments/cinza/card_corner_d.svg"),
};

const virtual_entries = archive_index.map(({ Content, ...entry }, index) => ({
  ...entry,
  index,
  key: `${entry.slug}:${index}`,
}));
---

<nigredo data-shape="list" class="sol__nigredo_archive" data-nigredo-archive>
  <!-- Filter block: party_roster outer vessel -->
  <div class="sol__nigredo_filter_block" data-nigredo-filter-rail>
    <!-- Header row: label + clear -->
    <div class="sol__nigredo_filter_header">
      <span class="sol__nigredo_filter_title">afflictions</span>
      <button
        class="sol__nigredo_filter_clear sol__text_kicker"
        data-nigredo-filter-clear
        type="button"
        hidden>clear</button
      >
    </div>

    <!-- Inner field: status_effects grouped into fire containers. -->
    <div class="sol__nigredo_filter_field">
      <div class="sol__nigredo_filter_groups">
        {
          NIGREDO_CONTAINERS.map((container) => (
            <div
              class="sol__nigredo_filter_group"
              data-container={container.key}
            >
              <button
                class="sol__nigredo_filter_group_label"
                data-filter-container={container.key}
                data-active="false"
                type="button"
                aria-pressed="false"
                aria-label={`toggle ${container.label} afflictions`}
              >
                {container.label}
              </button>
              <div class="sol__nigredo_filter_pills">
                {container.states.map((state) => (
                  <button
                    class="sol__nigredo_filter_btn sol__nigredo_pill"
                    data-filter-state={state.key}
                    data-container={container.key}
                    data-active="false"
                    type="button"
                    title={state.gloss || undefined}
                  >
                    {state.label}
                  </button>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Status row -->
  <div class="sol__nigredo_archive_status">
    <span
      class="sol__nigredo_archive_count sol__text_kicker"
      data-nigredo-count
    >
      {archive_index.length}
    </span>
    <span class="sol__nigredo_archive_count_label sol__text_kicker"
      >fragments</span
    >
    <span
      class="sol__nigredo_archive_filter_summary sol__text_kicker"
      data-nigredo-filter-summary
      hidden></span>
  </div>

  <!-- Feed pane: window-scrolled virtual track. -->
  <div class="sol__nigredo_scroll_pane" data-nigredo-scroll>
    <div class="sol__nigredo_inner_track" data-nigredo-inner>
      <ol class="sol__nigredo_list" data-nigredo-list></ol>
    </div>
  </div>
</nigredo>

<script
  id="sol_nigredo_archive_index"
  type="application/json"
  set:html={JSON.stringify(virtual_entries)}
/>

{
  archive_index.map((entry, index) => {
    const body_id = `sol_nigredo_entry_body_${index}`;
    const tone = entry.featured ? "rupture" : "quiet";
    const state_list = entry.states ?? [];
    const EntryContent = entry.Content;

    return (
      <template data-nigredo-entry-template data-index={index}>
        <li
          class="sol__nigredo_entry_row"
          data-align={entry.align}
          data-nigredo-entry
          data-entry-index={index}
          data-states={state_list.join(" ")}
          data-expanded="false"
        >
          <nigredo
            data-shape="entry"
            class="sol__nigredo_entry"
            data-tone={tone}
            data-container={entry.primary_container}
          >
            <article class="sol__nigredo_entry_card">
              <span class="sol__nigredo_entry_layer sol__nigredo_entry_layer_surface" />
              <span class="sol__nigredo_entry_layer sol__nigredo_entry_layer_ash" />
              <span class="sol__nigredo_entry_layer sol__nigredo_entry_layer_frame" />
              <div class="sol__nigredo_entry_layer sol__nigredo_entry_layer_ornament">
                <img
                  class="sol__nigredo_entry_ornament sol__nigredo_entry_ornament_corner_tl"
                  src={ornament_srcs.corner_tl}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <img
                  class="sol__nigredo_entry_ornament sol__nigredo_entry_ornament_corner_tr"
                  src={ornament_srcs.corner_tr}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <img
                  class="sol__nigredo_entry_ornament sol__nigredo_entry_ornament_corner_bl"
                  src={ornament_srcs.corner_bl}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <img
                  class="sol__nigredo_entry_ornament sol__nigredo_entry_ornament_corner_br"
                  src={ornament_srcs.corner_br}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="sol__nigredo_entry_layer_body">
                <header class="sol__nigredo_entry_header">
                  <ContentLink
                    href={entry.href}
                    class="sol__nigredo_entry_title"
                    data-redacted={entry.title_redacted}
                  >
                    {entry.display_title}
                  </ContentLink>

                  {entry.excerpt && (
                    <div class="sol__nigredo_entry_excerpt">
                      {entry.excerpt.split(/\n{2,}/).map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                    </div>
                  )}

                  <div class="sol__nigredo_entry_states" aria-label="states">
                    {state_list.map((state) => (
                      <span
                        class="sol__nigredo_pill"
                        data-state={state}
                        data-container={
                          NIGREDO_STATE_TO_CONTAINER[state] ?? "cinder"
                        }
                        title={NIGREDO_STATE_GLOSS[state] || undefined}
                      >
                        {NIGREDO_STATE_LABEL[state] ?? state}
                      </span>
                    ))}
                  </div>

                  <time
                    class="sol__nigredo_entry_date"
                    datetime={entry.published_at}
                  >
                    {entry.published_at}
                  </time>
                </header>

                {entry.preview && (
                  <div class="sol__nigredo_entry_preview" data-nigredo-preview>
                    {entry.preview.split(/\n{2,}/).map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                )}

                <div
                  id={body_id}
                  class="sol__nigredo_entry_full sol__chapter_content"
                  data-nigredo-full
                  hidden
                >
                  <EntryContent />
                </div>

                <footer class="sol__nigredo_entry_actions">
                  {entry.can_expand && (
                    <button
                      class="sol__nigredo_entry_expand sol__text_kicker"
                      type="button"
                      data-nigredo-expand
                      aria-controls={body_id}
                      aria-expanded="false"
                    >
                      read more
                    </button>
                  )}
                  <ContentLink
                    href={entry.href}
                    class="sol__nigredo_entry_open sol__text_kicker"
                  >
                    open entry
                  </ContentLink>
                </footer>
              </div>
            </article>
          </nigredo>
        </li>
      </template>
    );
  })
}

<noscript>
  <ol class="sol__nigredo_list sol__nigredo_list_fallback">
    {
      archive_index.slice(0, 12).map((entry) => (
        <li>
          <ContentLink href={entry.href}>{entry.display_title}</ContentLink>
        </li>
      ))
    }
  </ol>
</noscript>

<script>
  import { init_nigredo_archive } from "../../scripts/nigredo_archive.js";
  init_nigredo_archive();
</script>
