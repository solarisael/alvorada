---
/**
 * NigredoList — archive shell.
 * Filter block: party_roster vessel + status_effects grouped pills
 * + memory_fragment trace on the inner field.
 * Virtualizer driven by nigredo_archive.js.
 */

const ALL_STATES = [
  "grief",
  "dread",
  "shame",
  "guilt",
  "envy",
  "spite",
  "ache",
  "panic",
  "ruin",
  "numb",
  "hunger",
  "rot",
  "doubt",
  "rage",
  "loneliness",
  "exhaustion",
];

const INWARD = new Set([
  "grief",
  "dread",
  "shame",
  "guilt",
  "ache",
  "numb",
  "doubt",
  "loneliness",
  "exhaustion",
  "panic",
  "ruin",
  "hunger",
]);

const { archive_index = [], base_path = "" } = Astro.props;
---

<nigredo data-shape="list" class="sol__nigredo_archive" data-nigredo-archive>
  <!-- Filter block: party_roster outer vessel -->
  <div class="sol__nigredo_filter_block" data-nigredo-filter-rail>
    <!-- Header row: label + clear -->
    <div class="sol__nigredo_filter_header">
      <span class="sol__nigredo_filter_title">afflictions</span>
      <button
        class="sol__nigredo_filter_clear sol__text_kicker"
        data-nigredo-filter-clear
        type="button"
        hidden>clear</button
      >
    </div>

    <!-- Inner field: status_effects grouped pills with memory_fragment trace -->
    <div class="sol__nigredo_filter_field">
      <div class="sol__nigredo_filter_pills">
        {
          ALL_STATES.map((state) => (
            <button
              class="sol__nigredo_filter_btn sol__nigredo_pill"
              data-filter-state={state}
              data-family={INWARD.has(state) ? "ash" : "ember"}
              data-active="false"
              type="button"
            >
              {state}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Status row -->
  <div class="sol__nigredo_archive_status">
    <span class="sol__nigredo_archive_count sol__text_kicker" data-nigredo-count>
      {archive_index.length}
    </span>
    <span class="sol__nigredo_archive_count_label sol__text_kicker">fragments</span>
    <span
      class="sol__nigredo_archive_filter_summary sol__text_kicker"
      data-nigredo-filter-summary
      hidden></span>
  </div>

  <!-- Scroll pane: bounded overflow container.
       data-base-path consumed by RowPool in nigredo_archive.js. -->
  <div
    class="sol__nigredo_scroll_pane"
    data-nigredo-scroll
    data-base-path={base_path}
  >
    <!-- Inner track: TanStack sets height here. position:relative gives rows a stable origin. -->
    <div class="sol__nigredo_inner_track" data-nigredo-inner>
      <ol class="sol__nigredo_list" data-nigredo-list></ol>
    </div>
  </div>
</nigredo>

<!-- Archive index — consumed by nigredo_archive.js -->
<script
  id="sol_nigredo_archive_index"
  type="application/json"
  set:html={JSON.stringify(archive_index)}
/>

<!-- Entry template — cloned per virtual row.
     Ornament srcs use data-ornament-src so RowPool can set them at runtime. -->
<template id="sol_nigredo_entry_template">
  <li class="sol__nigredo_entry_row" data-align="left">
    <nigredo data-shape="entry" class="sol__nigredo_entry" data-tone="quiet">
      <a class="sol__nigredo_entry_link" href="#">
        <span class="sol__nigredo_entry_layer sol__nigredo_entry_layer_surface"></span>
        <span class="sol__nigredo_entry_layer sol__nigredo_entry_layer_ash"></span>
        <span class="sol__nigredo_entry_layer sol__nigredo_entry_layer_frame"></span>
        <div class="sol__nigredo_entry_layer sol__nigredo_entry_layer_ornament">
          <img
            class="sol__nigredo_entry_ornament sol__nigredo_entry_ornament_corner_tl"
            data-ornament-src="/ornaments/cinza/card_corner_a.svg"
            src=""
            alt=""
            loading="lazy"
            decoding="async"
          />
          <img
            class="sol__nigredo_entry_ornament sol__nigredo_entry_ornament_corner_tr"
            data-ornament-src="/ornaments/cinza/card_corner_b.svg"
            src=""
            alt=""
            loading="lazy"
            decoding="async"
          />
          <img
            class="sol__nigredo_entry_ornament sol__nigredo_entry_ornament_corner_bl"
            data-ornament-src="/ornaments/cinza/card_corner_c.svg"
            src=""
            alt=""
            loading="lazy"
            decoding="async"
          />
          <img
            class="sol__nigredo_entry_ornament sol__nigredo_entry_ornament_corner_br"
            data-ornament-src="/ornaments/cinza/card_corner_d.svg"
            src=""
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="sol__nigredo_entry_layer_body">
          <header class="sol__nigredo_entry_header">
            <span class="sol__nigredo_entry_title"></span>
            <span class="sol__nigredo_pill" data-state="" data-family="ash"></span>
            <time class="sol__nigredo_entry_date"></time>
          </header>
          <div class="sol__nigredo_entry_excerpt"><p></p></div>
        </div>
      </a>
    </nigredo>
  </li>
</template>

<script>
  import { init_nigredo_archive } from "../../scripts/nigredo_archive.js";
  init_nigredo_archive();
</script>
