---
import NigredoPill from "./pill.astro";

/**
 * Derives a redaction string length from a slug deterministically.
 * Range: 4–12 squares.
 */
function redact_length(slug) {
  let hash = 0;
  for (let i = 0; i < slug.length; i++) {
    hash = (hash * 31 + slug.charCodeAt(i)) >>> 0;
  }
  return 4 + (hash % 9); // 4–12
}

const {
  slug,
  title,
  published_at,
  state,
  excerpt,
  tone = "quiet",
  base_path = "",
} = Astro.props;

const display_title = title ? title : "■".repeat(redact_length(slug));

const href = `${base_path}/nigredo/${slug}`;
---

<nigredo data-shape="entry" class="sol__nigredo_entry" data-tone={tone}>
  <a class="sol__nigredo_entry_link" href={href}>
    <!-- Layer stack mirrors home-card architecture -->
    <span class="sol__nigredo_entry_layer sol__nigredo_entry_layer_surface"></span>
    <span class="sol__nigredo_entry_layer sol__nigredo_entry_layer_ash"></span>
    <span class="sol__nigredo_entry_layer sol__nigredo_entry_layer_frame"></span>
    <div class="sol__nigredo_entry_layer sol__nigredo_entry_layer_ornament">
      <img
        class="sol__nigredo_entry_ornament sol__nigredo_entry_ornament_corner_tl"
        src={`${base_path}/ornaments/cinza/card_corner_a.svg`}
        alt=""
        loading="lazy"
        decoding="async"
      />
      <img
        class="sol__nigredo_entry_ornament sol__nigredo_entry_ornament_corner_tr"
        src={`${base_path}/ornaments/cinza/card_corner_b.svg`}
        alt=""
        loading="lazy"
        decoding="async"
      />
      <img
        class="sol__nigredo_entry_ornament sol__nigredo_entry_ornament_corner_bl"
        src={`${base_path}/ornaments/cinza/card_corner_c.svg`}
        alt=""
        loading="lazy"
        decoding="async"
      />
      <img
        class="sol__nigredo_entry_ornament sol__nigredo_entry_ornament_corner_br"
        src={`${base_path}/ornaments/cinza/card_corner_d.svg`}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="sol__nigredo_entry_layer_body">
      <header class="sol__nigredo_entry_header">
        <span class="sol__nigredo_entry_title" data-redacted={!title}
          >{display_title}</span
        >
        <NigredoPill state={state} />
        <time class="sol__nigredo_entry_date" datetime={published_at}
          >{published_at}</time
        >
      </header>
      {
        excerpt && (
          <div class="sol__nigredo_entry_excerpt">
            <p>{excerpt}</p>
          </div>
        )
      }
    </div>
  </a>
</nigredo>
