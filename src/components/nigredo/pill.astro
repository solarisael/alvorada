---
import {
  NIGREDO_STATE_TO_CONTAINER,
  NIGREDO_STATE_LABEL,
  NIGREDO_STATE_GLOSS,
} from "../../data/nigredo_taxonomy.js";

const { state } = Astro.props;

const container = NIGREDO_STATE_TO_CONTAINER[state] ?? "cinder";
const label = NIGREDO_STATE_LABEL[state] ?? state;
const gloss = NIGREDO_STATE_GLOSS[state] || undefined;
---

<nigredo
  data-shape="pill"
  class="sol__nigredo_pill"
  data-state={state}
  data-container={container}
  title={gloss}>{label}</nigredo
>