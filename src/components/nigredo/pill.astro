---
import { NIGREDO_STATE_TO_CONTAINER } from "../../data/nigredo_taxonomy.js";

const { state } = Astro.props;

const container = NIGREDO_STATE_TO_CONTAINER[state] ?? "cinder";
---

<nigredo
  data-shape="pill"
  class="sol__nigredo_pill"
  data-state={state}
  data-container={container}>{state}</nigredo
>
