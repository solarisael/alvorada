---
import { ALBEDO_STATE_TO_CONTAINER } from "../../data/albedo_taxonomy.js";

const { state } = Astro.props;

const container = ALBEDO_STATE_TO_CONTAINER[state] ?? "morning-dew";
---

<albedo
  data-shape="pill"
  class="sol__albedo_pill"
  data-state={state}
  data-container={container}>{state}</albedo
>
