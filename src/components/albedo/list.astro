---
/**
 * AlbedoList — virtual feed shell (parallel to NigredoList).
 * Astro emits one inert template per entry plus precomputed size/data payloads;
 * the client only windows, filters, and expands. Same machinery as nigredo,
 * washed register: no redaction, light/water container tints.
 */

import ContentLink from "../page/content_link.astro";
import {
  ALBEDO_CONTAINERS,
  ALBEDO_STATE_TO_CONTAINER,
} from "../../data/albedo_taxonomy.js";
import { with_base } from "../../utils/routes.js";

const { archive_index = [] } = Astro.props;

const ornament_srcs = {
  corner_tl: with_base("ornaments/cinza/card_corner_a.svg"),
  corner_tr: with_base("ornaments/cinza/card_corner_b.svg"),
  corner_bl: with_base("ornaments/cinza/card_corner_c.svg"),
  corner_br: with_base("ornaments/cinza/card_corner_d.svg"),
};

const virtual_entries = archive_index.map(({ Content, ...entry }, index) => ({
  ...entry,
  index,
  key: `${entry.slug}:${index}`,
}));
---

<albedo data-shape="list" class="sol__albedo_archive" data-albedo-archive>
  <!-- Filter block: calm grouped state field -->
  <div class="sol__albedo_filter_block" data-albedo-filter-rail>
    <!-- Header row: label + clear -->
    <div class="sol__albedo_filter_header">
      <span class="sol__albedo_filter_title">states</span>
      <button
        class="sol__albedo_filter_clear sol__text_kicker"
        data-albedo-filter-clear
        type="button"
        hidden>clear</button
      >
    </div>

    <!-- Inner field: states grouped into light/water containers. -->
    <div class="sol__albedo_filter_field">
      <div class="sol__albedo_filter_groups">
        {
          ALBEDO_CONTAINERS.map((container) => (
            <div
              class="sol__albedo_filter_group"
              data-container={container.key}
            >
              <button
                class="sol__albedo_filter_group_label"
                data-filter-container={container.key}
                data-active="false"
                type="button"
                aria-pressed="false"
                aria-label={`toggle ${container.label} states`}
              >
                {container.label}
              </button>
              <div class="sol__albedo_filter_pills">
                {container.states.map((state) => (
                  <button
                    class="sol__albedo_filter_btn sol__albedo_pill"
                    data-filter-state={state}
                    data-container={container.key}
                    data-active="false"
                    type="button"
                  >
                    {state}
                  </button>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Status row -->
  <div class="sol__albedo_archive_status">
    <span
      class="sol__albedo_archive_count sol__text_kicker"
      data-albedo-count
    >
      {archive_index.length}
    </span>
    <span class="sol__albedo_archive_count_label sol__text_kicker"
      >notes</span
    >
    <span
      class="sol__albedo_archive_filter_summary sol__text_kicker"
      data-albedo-filter-summary
      hidden></span>
  </div>

  <!-- Feed pane: window-scrolled virtual track. -->
  <div class="sol__albedo_scroll_pane" data-albedo-scroll>
    <div class="sol__albedo_inner_track" data-albedo-inner>
      <ol class="sol__albedo_list" data-albedo-list></ol>
    </div>
  </div>
</albedo>

<script
  id="sol_albedo_archive_index"
  type="application/json"
  set:html={JSON.stringify(virtual_entries)}
/>

{
  archive_index.map((entry, index) => {
    const body_id = `sol_albedo_entry_body_${index}`;
    const tone = entry.featured ? "bloom" : "still";
    const state_list = entry.states ?? [];
    const EntryContent = entry.Content;

    return (
      <template data-albedo-entry-template data-index={index}>
        <li
          class="sol__albedo_entry_row"
          data-align={entry.align}
          data-albedo-entry
          data-entry-index={index}
          data-states={state_list.join(" ")}
          data-expanded="false"
        >
          <albedo
            data-shape="entry"
            class="sol__albedo_entry"
            data-tone={tone}
            data-container={entry.primary_container}
          >
            <article class="sol__albedo_entry_card">
              <span class="sol__albedo_entry_layer sol__albedo_entry_layer_surface" />
              <span class="sol__albedo_entry_layer sol__albedo_entry_layer_sheen" />
              <span class="sol__albedo_entry_layer sol__albedo_entry_layer_frame" />
              <div class="sol__albedo_entry_layer sol__albedo_entry_layer_ornament">
                <img
                  class="sol__albedo_entry_ornament sol__albedo_entry_ornament_corner_tl"
                  src={ornament_srcs.corner_tl}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <img
                  class="sol__albedo_entry_ornament sol__albedo_entry_ornament_corner_tr"
                  src={ornament_srcs.corner_tr}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <img
                  class="sol__albedo_entry_ornament sol__albedo_entry_ornament_corner_bl"
                  src={ornament_srcs.corner_bl}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <img
                  class="sol__albedo_entry_ornament sol__albedo_entry_ornament_corner_br"
                  src={ornament_srcs.corner_br}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="sol__albedo_entry_layer_body">
                <header class="sol__albedo_entry_header">
                  <ContentLink
                    href={entry.href}
                    class="sol__albedo_entry_title"
                    data-untitled={entry.title_untitled}
                  >
                    {entry.display_title}
                  </ContentLink>

                  {entry.excerpt && (
                    <div class="sol__albedo_entry_excerpt">
                      {entry.excerpt.split(/\n{2,}/).map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                    </div>
                  )}

                  <div class="sol__albedo_entry_states" aria-label="states">
                    {state_list.map((state) => (
                      <span
                        class="sol__albedo_pill"
                        data-state={state}
                        data-container={
                          ALBEDO_STATE_TO_CONTAINER[state] ?? "morning-dew"
                        }
                      >
                        {state}
                      </span>
                    ))}
                  </div>

                  <time
                    class="sol__albedo_entry_date"
                    datetime={entry.published_at}
                  >
                    {entry.published_at}
                  </time>
                </header>

                {entry.preview && (
                  <div class="sol__albedo_entry_preview" data-albedo-preview>
                    {entry.preview.split(/\n{2,}/).map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                )}

                <div
                  id={body_id}
                  class="sol__albedo_entry_full sol__chapter_content"
                  data-albedo-full
                  hidden
                >
                  <EntryContent />
                </div>

                <footer class="sol__albedo_entry_actions">
                  {entry.can_expand && (
                    <button
                      class="sol__albedo_entry_expand sol__text_kicker"
                      type="button"
                      data-albedo-expand
                      aria-controls={body_id}
                      aria-expanded="false"
                    >
                      read more
                    </button>
                  )}
                  <ContentLink
                    href={entry.href}
                    class="sol__albedo_entry_open sol__text_kicker"
                  >
                    open entry
                  </ContentLink>
                </footer>
              </div>
            </article>
          </albedo>
        </li>
      </template>
    );
  })
}

<noscript>
  <ol class="sol__albedo_list sol__albedo_list_fallback">
    {
      archive_index.slice(0, 12).map((entry) => (
        <li>
          <ContentLink href={entry.href}>{entry.display_title}</ContentLink>
        </li>
      ))
    }
  </ol>
</noscript>

<script>
  import { init_albedo_archive } from "../../scripts/albedo_archive.js";
  init_albedo_archive();
</script>