---
/**
 * NigredoList — archive shell.
 * Filter block: party_roster vessel + status_effects grouped pills
 * + memory_fragment trace on the inner field.
 * Virtualizer driven by nigredo_archive.js.
 */

const ALL_STATES = [
  "grief",
  "dread",
  "shame",
  "guilt",
  "envy",
  "spite",
  "ache",
  "panic",
  "ruin",
  "numb",
  "hunger",
  "rot",
  "doubt",
  "rage",
  "loneliness",
  "exhaustion",
];

const INWARD = new Set([
  "grief",
  "dread",
  "shame",
  "guilt",
  "ache",
  "numb",
  "doubt",
  "loneliness",
  "exhaustion",
  "panic",
  "ruin",
  "hunger",
]);

const { archive_index = [], base_path = "" } = Astro.props;
---

<div class="nigredo-archive" data-nigredo-archive>
  <!-- Filter block: party_roster outer vessel -->
  <div class="nigredo-filter-block" data-nigredo-filter-rail>
    <!-- Header row: label + clear -->
    <div class="nigredo-filter-header">
      <span class="nigredo-filter-title">afflictions</span>
      <button
        class="nigredo-filter-clear text_kicker"
        data-nigredo-filter-clear
        type="button"
        hidden>clear</button
      >
    </div>

    <!-- Inner field: status_effects grouped pills with memory_fragment trace -->
    <div class="nigredo-filter-field">
      <div class="nigredo-filter-pills">
        {
          ALL_STATES.map((state) => (
            <button
              class="nigredo-filter-btn nigredo-pill"
              data-filter-state={state}
              data-family={INWARD.has(state) ? "ash" : "ember"}
              data-active="false"
              type="button"
            >
              {state}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Status row -->
  <div class="nigredo-archive-status">
    <span class="nigredo-archive-count text_kicker" data-nigredo-count>
      {archive_index.length}
    </span>
    <span class="nigredo-archive-count-label text_kicker">fragments</span>
    <span
      class="nigredo-archive-filter-summary text_kicker"
      data-nigredo-filter-summary
      hidden></span>
  </div>

  <!-- Scroll pane: bounded overflow container.
       data-base-path consumed by RowPool in nigredo_archive.js. -->
  <div
    class="nigredo-scroll-pane"
    data-nigredo-scroll
    data-base-path={base_path}
  >
    <!-- Inner track: TanStack sets height here. position:relative gives rows a stable origin. -->
    <div class="nigredo-inner-track" data-nigredo-inner>
      <ol class="nigredo-list" data-nigredo-list></ol>
    </div>
  </div>
</div>

<!-- Archive index — consumed by nigredo_archive.js -->
<script
  id="nigredo-archive-index"
  type="application/json"
  set:html={JSON.stringify(archive_index)}
/>

<!-- Entry template — cloned per virtual row.
     Ornament srcs use data-ornament-src so RowPool can set them at runtime.
     The read-more kicker is the explicit expand-trigger; click handler in
     nigredo_archive.js intercepts its clicks, preventDefault on the wrapping
     <a>, and toggles the row's data-expanded. Clicking elsewhere on the row
     (title / excerpt / padding) navigates via the anchor as normal. -->
<template id="nigredo-entry-template">
  <li class="nigredo-entry-row" data-align="left">
    <article class="nigredo-entry" data-variant="quiet">
      <a class="nigredo-entry-link" href="#">
        <span class="nigredo-entry-layer nigredo-entry-layer-surface"></span>
        <span class="nigredo-entry-layer nigredo-entry-layer-ash"></span>
        <span class="nigredo-entry-layer nigredo-entry-layer-frame"></span>
        <div class="nigredo-entry-layer nigredo-entry-layer-ornament">
          <img
            class="nigredo-entry-ornament nigredo-entry-ornament-corner-tl"
            data-ornament-src="/ornaments/cinza/card_corner_a.svg"
            src=""
            alt=""
            loading="lazy"
            decoding="async"
          />
          <img
            class="nigredo-entry-ornament nigredo-entry-ornament-corner-tr"
            data-ornament-src="/ornaments/cinza/card_corner_b.svg"
            src=""
            alt=""
            loading="lazy"
            decoding="async"
          />
          <img
            class="nigredo-entry-ornament nigredo-entry-ornament-corner-bl"
            data-ornament-src="/ornaments/cinza/card_corner_c.svg"
            src=""
            alt=""
            loading="lazy"
            decoding="async"
          />
          <img
            class="nigredo-entry-ornament nigredo-entry-ornament-corner-br"
            data-ornament-src="/ornaments/cinza/card_corner_d.svg"
            src=""
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="nigredo-entry-layer-body">
          <header class="nigredo-entry-header">
            <span class="nigredo-entry-title"></span>
            <span class="nigredo-pill" data-state="" data-family="ash"></span>
            <time class="nigredo-entry-date"></time>
          </header>
          <div class="nigredo-entry-excerpt"><p></p></div>
          <span
            class="nigredo-entry-readmore text_kicker"
            data-nigredo-readmore
            role="button"
            tabindex="0"
            aria-label="Expand this entry inline"
            ><span class="nigredo-entry-readmore-label">read more</span><span
              class="nigredo-entry-readmore-chevron"
              aria-hidden="true">↓</span
            ></span
          >
        </div>
      </a>
    </article>
  </li>
</template>

<script>
  import { init_nigredo_archive } from "../scripts/nigredo_archive.js";
  init_nigredo_archive();
</script>
