---
import { NAV_ORNAMENTS } from "../../data/nav_ornaments.js";
import { with_base } from "../../utils/routes.js";

const { kind, class_name = "" } = Astro.props;
const ornament = NAV_ORNAMENTS[kind];
const mask_url = ornament?.mask ? with_base(ornament.mask) : "";

if (!ornament) {
  throw new Error(`Unknown nav ornament: ${kind}`);
}
---

<span class={class_name} data-nav-ornament={kind}>
  {
    mask_url ? (
      <span
        class="sol__nav_ornament_svg sol__nav_ornament_mask"
        style={`--nav_ornament_mask_url: url(${mask_url})`}
      />
    ) : (
      <svg
        class="sol__nav_ornament_svg"
        viewBox={ornament.viewBox}
        width={ornament.width}
        focusable="false"
        height={ornament.height}
        preserveAspectRatio="xMidYMid meet"
      >
        <path fill="currentColor" fill-rule="evenodd" d={ornament.path} />
      </svg>
    )
  }
</span>
