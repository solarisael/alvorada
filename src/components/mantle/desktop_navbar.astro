---
import "../../styles/components/desktop_nav.css";
import NavOrnament from "./nav_ornament.astro";
import { DESKTOP_NAV_LEFT, DESKTOP_NAV_RIGHT } from "../../data/site_nav.js";
import { with_base } from "../../utils/routes.js";

const home_href = with_base("/");
---

<nav
  aria-label="Primary"
  data-shape="desktop_navbar"
  id="sol_desktop_nav"
  class="sol__navbar_preset_rich sol__route_active_tone_medium"
>
  <div
    id="sol_nav_user_bar"
    class="sol__nav_rail"
    data-nav-rail
    preload="mouseover"
  >
    <div class="sol__nav_rail_layer sol__nav_rail_layer_cursor_glow"></div>
    <div class="sol__nav_rail_layer sol__nav_rail_layer_outer_trace"></div>
    <div class="sol__nav_rail_layer sol__nav_rail_layer_inner_trace"></div>
    <NavOrnament
      kind="side_left"
      class_name="sol__nav_ornament sol__nav_ornament_side sol__nav_ornament_left"
    />
    <NavOrnament
      kind="side_right"
      class_name="sol__nav_ornament sol__nav_ornament_side sol__nav_ornament_right"
    />

    <div class="sol__nav_links">
      {
        DESKTOP_NAV_LEFT.map((nav_item) =>
          nav_item.disabled ? (
            <span
              class="sol__nav_pill sol__nav_pill_disabled"
              aria-disabled="true"
            >
              <span class="sol__nav_pill_layer sol__nav_pill_layer_ring" />
              {nav_item.label}
            </span>
          ) : (
            <a
              class="sol__nav_pill"
              data-nav-pill
              data-phase={nav_item.phase}
              href={with_base(nav_item.href)}
              hx-get={with_base(nav_item.href)}
            >
              <span class="sol__nav_pill_layer sol__nav_pill_layer_ring" />
              {nav_item.label}
            </a>
          ),
        )
      }
    </div>

    <div id="sol_middle_guy"></div>

    <a id="sol_icon_user" href={home_href} hx-get={home_href}>
      <span class="sol__icon_user_layer sol__icon_user_layer_orbit"></span>
      <NavOrnament
        kind="center_sun"
        class_name="sol__nav_ornament sol__nav_ornament_center"
      />

      <div id="sol_icon_user_shell">
        <div class="sol__cinza_sun_halo"></div>
        <div class="sol__cinza_sun_highlight"></div>
        <div id="sol_icon_user_shell_inner"></div>
      </div>

      <div id="sol_icon_user_core">
        <img
          id="sol_icon_user_photo"
          src={with_base("images/small_render_4.png")}
          alt="Solarisael hearth emblem"
        />
      </div>
    </a>

    <div class="sol__nav_links">
      {
        DESKTOP_NAV_RIGHT.map((nav_item) =>
          nav_item.disabled ? (
            <span
              class="sol__nav_pill sol__nav_pill_disabled"
              aria-disabled="true"
            >
              <span class="sol__nav_pill_layer sol__nav_pill_layer_ring" />
              {nav_item.label}
            </span>
          ) : (
            <a
              class="sol__nav_pill"
              data-nav-pill
              data-phase={nav_item.phase}
              href={with_base(nav_item.href)}
              hx-get={with_base(nav_item.href)}
            >
              <span class="sol__nav_pill_layer sol__nav_pill_layer_ring" />
              {nav_item.label}
            </a>
          ),
        )
      }
    </div>
  </div>
</nav>

<script type="module" src={with_base("js/modules/navbar_runtime.js")}></script>
