---
import "../../styles/components/desktop_nav.css";

const base_url = import.meta.env.BASE_URL;
const base_path = base_url.replace(/\/+$/, "");
const with_base = (path_value) => {
  const normalized_path = String(path_value).replace(/^\/+/, "");

  return `${base_path}/${normalized_path}`;
};
---

<mantle data-shape="desktop_navbar" id="sol_desktop_nav" class="navbar-preset-rich route-active-tone-medium">
  <div id="sol_nav_user_bar" class="nav-rail" data-nav-rail>
    <div class="nav-rail-layer nav-rail-layer-cursor-glow"></div>

    <div class="nav-links">
      <a
        class="nav-pill"
        data-nav-pill
        data-phase="nigredo"
        href={with_base("nigredo")}
        hx-get={with_base("nigredo")}
        hx-target="#sol_content"
        hx-select="#sol_content"
        hx-swap="morph swap:240ms settle:240ms"
        hx-push-url="true"
      >
        <span class="nav-pill-layer nav-pill-layer-ring"></span>
        nigredo</a
      >
      <a
        class="nav-pill"
        data-nav-pill
        data-phase="albedo"
        href={with_base("albedo")}
        hx-get={with_base("albedo")}
        hx-target="#sol_content"
        hx-select="#sol_content"
        hx-swap="morph swap:240ms settle:240ms"
        hx-push-url="true"
      >
        <span class="nav-pill-layer nav-pill-layer-ring"></span>
        albedo</a
      >
    </div>

    <div id="sol_middle_guy"></div>

    <a
      id="sol_icon_user"
      href={base_url}
      hx-get={base_url}
      hx-target="#sol_content"
      hx-select="#sol_content"
      hx-swap="morph swap:240ms settle:240ms"
      hx-push-url="true"
    >
      <span class="icon-user-layer icon-user-layer-orbit"></span>

      <div id="sol_icon_user_shell">
        <div class="cinza_sun_halo"></div>
        <div class="cinza_sun_highlight"></div>
        <div id="sol_icon_user_shell_inner"></div>
      </div>

      <div id="sol_icon_user_core">
        <img
          id="sol_icon_user_photo"
          src={with_base("images/sol-curr.jpg")}
          alt="Sol logo placeholder"
        />
      </div>
    </a>

    <div class="nav-links">
      <a
        class="nav-pill"
        data-nav-pill
        data-phase="citrinitas"
        href={with_base("citrinitas")}
        hx-get={with_base("citrinitas")}
        hx-target="#sol_content"
        hx-select="#sol_content"
        hx-swap="morph swap:240ms settle:240ms"
        hx-push-url="true"
      >
        <span class="nav-pill-layer nav-pill-layer-ring"></span>
        citrinitas</a
      >
      <a
        class="nav-pill"
        data-nav-pill
        data-phase="rubedo"
        href={with_base("rubedo")}
        hx-get={with_base("rubedo")}
        hx-target="#sol_content"
        hx-select="#sol_content"
        hx-swap="morph swap:240ms settle:240ms"
        hx-push-url="true"
      >
        <span class="nav-pill-layer nav-pill-layer-ring"></span>
        rubedo</a
      >
      <a
        class="nav-pill"
        data-nav-pill
        data-phase="codex"
        href={with_base("codex")}
        hx-get={with_base("codex")}
        hx-target="#sol_content"
        hx-select="#sol_content"
        hx-swap="morph swap:240ms settle:240ms"
        hx-push-url="true"
      >
        <span class="nav-pill-layer nav-pill-layer-ring"></span>
        codex</a
      >
    </div>
  </div>
</mantle>

<script type="module" src={with_base("js/modules/navbar_runtime.js")}></script>
