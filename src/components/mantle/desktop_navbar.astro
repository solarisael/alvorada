---
import "../../styles/components/desktop_nav.css";

const base_url = import.meta.env.BASE_URL;
const base_path = base_url.replace(/\/+$/, "");
const with_base = (path_value) => {
  const normalized_path = String(path_value).replace(/^\/+/, "");

  return `${base_path}/${normalized_path}`;
};
---

<mantle data-shape="desktop_navbar" id="sol_desktop_nav" class="sol__navbar_preset_rich sol__route_active_tone_medium">
  <div id="sol_nav_user_bar" class="sol__nav_rail" data-nav-rail>
    <div class="sol__nav_rail_layer sol__nav_rail_layer_cursor_glow"></div>

    <div class="sol__nav_links">
      <a
        class="sol__nav_pill"
        data-nav-pill
        data-phase="nigredo"
        href={with_base("nigredo")}
        hx-get={with_base("nigredo")}
      >
        <span class="sol__nav_pill_layer sol__nav_pill_layer_ring"></span>
        nigredo</a
      >
      <a
        class="sol__nav_pill"
        data-nav-pill
        data-phase="albedo"
        href={with_base("albedo")}
        hx-get={with_base("albedo")}
      >
        <span class="sol__nav_pill_layer sol__nav_pill_layer_ring"></span>
        albedo</a
      >
    </div>

    <div id="sol_middle_guy"></div>

    <a
      id="sol_icon_user"
      href={base_url}
      hx-get={base_url}
    >
      <span class="sol__icon_user_layer sol__icon_user_layer_orbit"></span>

      <div id="sol_icon_user_shell">
        <div class="sol__cinza_sun_halo"></div>
        <div class="sol__cinza_sun_highlight"></div>
        <div id="sol_icon_user_shell_inner"></div>
      </div>

      <div id="sol_icon_user_core">
        <img
          id="sol_icon_user_photo"
          src={with_base("images/sol-curr.jpg")}
          alt="Sol logo placeholder"
        />
      </div>
    </a>

    <div class="sol__nav_links">
      <a
        class="sol__nav_pill"
        data-nav-pill
        data-phase="citrinitas"
        href={with_base("citrinitas")}
        hx-get={with_base("citrinitas")}
      >
        <span class="sol__nav_pill_layer sol__nav_pill_layer_ring"></span>
        citrinitas</a
      >
      <a
        class="sol__nav_pill"
        data-nav-pill
        data-phase="rubedo"
        href={with_base("rubedo")}
        hx-get={with_base("rubedo")}
      >
        <span class="sol__nav_pill_layer sol__nav_pill_layer_ring"></span>
        rubedo</a
      >
      <a
        class="sol__nav_pill"
        data-nav-pill
        data-phase="codex"
        href={with_base("codex")}
        hx-get={with_base("codex")}
      >
        <span class="sol__nav_pill_layer sol__nav_pill_layer_ring"></span>
        codex</a
      >
    </div>
  </div>
</mantle>

<script type="module" src={with_base("js/modules/navbar_runtime.js")}></script>
