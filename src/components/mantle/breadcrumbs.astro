---
import "../../styles/components/breadcrumbs.css";

// crumbs: explicit array of { label, href } objects.
// When provided, bypasses the URL parser entirely — the page controls the trail.
// When null, falls back to the URL-parser with crumb_label_overrides.
//
// crumb_label_overrides: record of url segment -> human-readable label.
// Used as fallback when crumbs is not provided.
// theme_color: optional CSS color string or variable reference.
// When provided, overrides the phase color for --crumb_theme_color.
// Used by thread pages to color breadcrumbs per character identity.
const {
  crumbs = null,
  crumb_label_overrides = {},
  theme_color = null,
} = Astro.props;

const phase_color_by_name = {
  nigredo: "var(--color-nigredo)",
  albedo: "var(--color-albedo)",
  citrinitas: "var(--color-citrinitas)",
  rubedo: "var(--color-rubedo)",
  codex: "var(--color-codex)",
};

const base_url = import.meta.env.BASE_URL;
const base_path = base_url.replace(/\/+$/, "");
const with_base = (path_value) => {
  const normalized_path = String(path_value).replace(/^\/+/, "");
  return `${base_path}/${normalized_path}`;
};

const pathname_raw = Astro.url.pathname;
const pathname = pathname_raw.replace(/\/+$/, "") || "/";
const pathname_without_base = pathname.startsWith(base_path)
  ? pathname.slice(base_path.length) || "/"
  : pathname;
const path_segments =
  pathname_without_base === "/"
    ? []
    : pathname_without_base.slice(1).split("/");

const active_phase =
  path_segments[0] in phase_color_by_name ? path_segments[0] : "nigredo";

const segment_to_label = (segment) => {
  const decoded_segment = decodeURIComponent(segment);
  return decoded_segment.replace(/[-_]+/g, " ").replace(/\s+/g, " ").trim();
};

// Resolve the crumb list — explicit or URL-derived.
let crumb_items;

if (Array.isArray(crumbs) && crumbs.length > 0) {
  // Explicit crumbs passed by the page. Hrefs are already base-resolved.
  crumb_items = crumbs;
} else {
  // URL-derived fallback.
  crumb_items = [{ href: with_base("/"), label: "home" }];
  let current_path = "";

  path_segments.forEach((segment) => {
    current_path += `/${segment}`;

    const label =
      segment in crumb_label_overrides
        ? crumb_label_overrides[segment]
        : segment_to_label(segment);

    crumb_items.push({
      href: with_base(current_path),
      label,
    });
  });
}

const current_crumb_href = crumb_items.at(-1)?.href ?? with_base("/");
const active_theme_color =
  theme_color ??
  phase_color_by_name[active_phase] ??
  "var(--site_style_accent)";
---

<mantle
  data-shape="breadcrumbs"
  id="sol_breadcrumbs"
  data-phase={active_phase}
  style={`--crumb_theme_color: ${active_theme_color};`}
>
  <div class="sol__breadcrumb_divider"></div>

  <ol>
    {
      crumb_items.map((crumb_item) => {
        const is_current = crumb_item.href === current_crumb_href;

        return (
          <li class={is_current ? "sol__is_current" : "sol__is_parent"}>
            <a
              href={crumb_item.href}
              class:list={{ "sol__is_current_link": is_current }}
            >
              {crumb_item.label}
            </a>
          </li>
        );
      })
    }
  </ol>
</mantle>

<script type="module" src={with_base("js/modules/breadcrumbs_runtime.js")}
></script>
