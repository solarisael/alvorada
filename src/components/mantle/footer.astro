---
import { resolve_footer_sentences } from "../../data/footer_sentences.js";

// Default footer for the layout's "footer" slot.
// Per-page override available via <Fragment slot="footer">...</Fragment>.
// Per-phase content via the phase prop — pages pass phase down through the layout.
const { phase = "nigredo" } = Astro.props;
const footer_rows = resolve_footer_sentences(phase);
const footer_row = footer_rows[0];
const has_content = Boolean(footer_row?.html?.trim());
---

<footer
  data-shape="footer"
  id="sol_footer"
  data-phase={phase}
  data-state={has_content ? "filled" : "empty"}
>
  {
    has_content && (
      <>
        {footer_rows.length > 1 && (
          <button
            type="button"
            class="sol__footer_step"
            data-footer-cycle-step="prev"
            aria-label="Previous sentence"
          >
            ‹
          </button>
        )}
        <span
          data-footer-cycle
          data-sol-pretext="justify"
          data-cycle-align={footer_row.align}
          set:html={footer_row.html}
        />
        {footer_rows.length > 1 && (
          <button
            type="button"
            class="sol__footer_step"
            data-footer-cycle-step="next"
            aria-label="Next sentence"
          >
            ›
          </button>
        )}
      </>
    )
  }
</footer>
