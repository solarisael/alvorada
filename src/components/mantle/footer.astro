---
// Default footer for the layout's "footer" slot.
// Per-page override available via <Fragment slot="footer">...</Fragment>.
// Per-phase content via the phase prop — pages pass phase down through the layout.

const { phase = "nigredo" } = Astro.props;

const footer_html_by_phase = {
  nigredo: "Made with pure hatred <br />You should all die",
  albedo: "",
  citrinitas: "",
  rubedo: "",
  codex: "",
};

const html = footer_html_by_phase[phase] ?? footer_html_by_phase.nigredo;
const has_content = html.trim().length > 0;
---

<mantle
  data-shape="footer"
  id="sol_footer"
  data-phase={phase}
  data-state={has_content ? "filled" : "empty"}
>
  {has_content && <span set:html={html} />}
</mantle>
