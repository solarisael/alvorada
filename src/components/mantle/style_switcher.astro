---
import "../../styles/components/style_switcher.css";
import { with_base } from "../../utils/routes.js";

const theme_options = [
  {
    label: "cinza",
    value: "cinza",
  },
];

const fx_options = [
  {
    label: "subtle",
    value: "subtle",
  },
  {
    label: "balanced",
    value: "balanced",
  },
  {
    label: "bold",
    value: "bold",
  },
];

const shell_options = [
  {
    label: "subtle",
    value: "subtle",
  },
  {
    label: "medium",
    value: "medium",
  },
  {
    label: "strong",
    value: "strong",
  },
];
---

<mantle
  data-shape="style_switcher"
  id="sol_style_switcher"
  data-style-collapsed="true"
>
  <button
    id="sol_style_switcher_toggle"
    class="sol__text_caption"
    type="button"
    data-style-toggle
    data-expanded="false"
  >
    style
  </button>

  <div id="sol_style_switcher_panel" data-style-panel>
    <p id="sol_style_switcher_title" class="sol__text_caption">style</p>

    <label class="sol__style_switcher_group" for="style_switcher_theme">
      <span class="sol__style_switcher_label sol__text_caption">theme</span>
      <select id="sol_style_switcher_theme" data-style-theme>
        {
          theme_options.map((theme_option) => (
            <option value={theme_option.value}>{theme_option.label}</option>
          ))
        }
      </select>
    </label>

    <label class="sol__style_switcher_group" for="style_switcher_fx">
      <span class="sol__style_switcher_label sol__text_caption">intensity</span>
      <select id="sol_style_switcher_fx" data-style-fx>
        {
          fx_options.map((fx_option) => (
            <option value={fx_option.value}>{fx_option.label}</option>
          ))
        }
      </select>
    </label>

    <label class="sol__style_switcher_group" for="style_switcher_shell">
      <span class="sol__style_switcher_label sol__text_caption">shell</span>
      <select id="sol_style_switcher_shell" data-style-shell>
        {
          shell_options.map((shell_option) => (
            <option value={shell_option.value}>{shell_option.label}</option>
          ))
        }
      </select>
    </label>
  </div>
</mantle>

<script type="module" src={with_base("js/modules/style_switcher_runtime.js")}
></script>
