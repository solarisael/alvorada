---
import "../../styles/components/mobile_nav.css";
import { with_base } from "../../utils/routes.js";

const home_href = with_base("/");
---

<mantle data-shape="mobile_navbar" id="sol_mobile_nav">
  <div id="sol_mobile_nav_shell">
    <div class="sol__mobile_nav_side sol__mobile_nav_left">
      <a
        class="sol__mobile_nav_link sol__is_mobile_hearth_link"
        data-mobile-nav-pill
        data-phase="home"
        href={home_href}
        hx-get={home_href}
      >
        <span class="sol__mobile_nav_layer sol__mobile_nav_layer_topline"></span>
        <span class="sol__mobile_nav_icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="M4.5 10.8 12 4l7.5 6.8" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M6.8 10.2V20h10.4v-9.8" stroke-linejoin="round"></path>
            <path d="M10 20v-5.4h4V20" stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="sol__mobile_nav_label">hea</span>
      </a>

      <a
        class="sol__mobile_nav_link"
        data-mobile-nav-pill
        data-phase="nigredo"
        href={with_base("nigredo")}
        hx-get={with_base("nigredo")}
      >
        <span class="sol__mobile_nav_layer sol__mobile_nav_layer_topline"
        ></span>
        <span class="sol__mobile_nav_icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="M9 3h6" stroke-linecap="round"></path>
            <path
              d="M10 3v4l-4.8 7.1a5.6 5.6 0 0 0 4.6 8.9h4.4a5.6 5.6 0 0 0 4.6-8.9L14 7V3"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path d="M7.7 17.2h8.6" stroke-linecap="round"></path>
          </svg>
        </span>
        <span class="sol__mobile_nav_label">nig</span>
      </a>

      <a
        class="sol__mobile_nav_link"
        data-mobile-nav-pill
        data-phase="albedo"
        href={with_base("albedo")}
        hx-get={with_base("albedo")}
      >
        <span class="sol__mobile_nav_layer sol__mobile_nav_layer_topline"
        ></span>
        <span class="sol__mobile_nav_icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="M12 4 4.5 18h15L12 4Z" stroke-linejoin="round"></path>
            <path d="M12 8v6" stroke-linecap="round"></path>
            <circle cx="12" cy="17" r="1" fill="currentColor" stroke="none"
            ></circle>
          </svg>
        </span>
        <span class="sol__mobile_nav_label">alb</span>
      </a>
    </div>

    <a
      class="sol__mobile_nav_link sol__is_home_link"
      data-mobile-home
      href={home_href}
      hx-get={home_href}
    >
      <span class="sol__mobile_nav_layer sol__mobile_nav_layer_topline"></span>
      <span class="sol__mobile_home_orbit"></span>
      <span class="sol__mobile_home_avatar">
        <span class="sol__mobile_home_avatar_shell">
          <span class="sol__mobile_cinza_sun_halo"></span>
          <span class="sol__mobile_cinza_sun_highlight"></span>
        </span>
        <span class="sol__mobile_home_avatar_core">
          <img src={with_base("images/sol-curr.jpg")} alt="" />
        </span>
      </span>
    </a>

    <div class="sol__mobile_nav_side sol__mobile_nav_right">
      <a
        class="sol__mobile_nav_link"
        data-mobile-nav-pill
        data-phase="citrinitas"
        href={with_base("citrinitas")}
        hx-get={with_base("citrinitas")}
      >
        <span class="sol__mobile_nav_layer sol__mobile_nav_layer_topline"
        ></span>
        <span class="sol__mobile_nav_icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <circle cx="12" cy="12" r="3.2"></circle>
            <path
              d="M12 2.8V6M12 18v3.2M2.8 12H6M18 12h3.2M5.3 5.3l2.2 2.2M16.5 16.5l2.2 2.2M18.7 5.3l-2.2 2.2M7.5 16.5l-2.2 2.2"
              stroke-linecap="round"></path>
          </svg>
        </span>
        <span class="sol__mobile_nav_label">cit</span>
      </a>

      <a
        class="sol__mobile_nav_link"
        data-mobile-nav-pill
        data-phase="rubedo"
        href={with_base("rubedo")}
        hx-get={with_base("rubedo")}
      >
        <span class="sol__mobile_nav_layer sol__mobile_nav_layer_topline"
        ></span>
        <span class="sol__mobile_nav_icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              d="M12 3.2c2.7 3.5 5 5.6 5 8.8a5 5 0 1 1-10 0c0-2.8 1.7-4.6 3.2-6.7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M12 10.2c1.2 1.3 2.2 2.2 2.2 3.6a2.2 2.2 0 0 1-4.4 0c0-1.2.8-2 1.5-2.9"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="sol__mobile_nav_label">rub</span>
      </a>

      <a
        class="sol__mobile_nav_link"
        data-mobile-nav-pill
        data-phase="codex"
        href={with_base("codex")}
        hx-get={with_base("codex")}
      >
        <span class="sol__mobile_nav_layer sol__mobile_nav_layer_topline"
        ></span>
        <span class="sol__mobile_nav_icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <circle cx="12" cy="12" r="2.8"></circle>
            <path
              d="M12 3v2.2M12 18.8V21M3 12h2.2M18.8 12H21M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6"
              stroke-linecap="round"></path>
            <circle cx="12" cy="12" r="6.1" stroke-dasharray="2 1.5"></circle>
          </svg>
        </span>
        <span class="sol__mobile_nav_label">cdx</span>
      </a>
    </div>
  </div>
</mantle>

<script type="module" src={with_base("js/modules/mobile_nav_runtime.js")}
></script>
