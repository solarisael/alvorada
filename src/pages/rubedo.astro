---
import IndexLayout from "../layouts/index.astro";
import PageHero from "../components/page/hero.astro";
import PageSection from "../components/page/section.astro";
import BookList from "../components/rubedo/book_list.astro";
import {
  rubedo_book_map,
  derive_chapter_slug,
} from "../data/rubedo/book_timeline_runtime.js";
import { with_base } from "../utils/routes.js";

const book_slugs = Object.keys(rubedo_book_map);

const book_links = book_slugs.map((book_slug) => {
  const book_entry = rubedo_book_map[book_slug] ?? null;
  const sorted_chapters = [...(book_entry?.chapters ?? [])].sort(
    (left_chapter, right_chapter) =>
      left_chapter.timeline_position - right_chapter.timeline_position,
  );
  const first_chapter = sorted_chapters[0] ?? null;
  const book_href = with_base(`/rubedo/${book_slug}`);
  const reader_href = first_chapter
    ? with_base(
        `/rubedo/${book_slug}/${derive_chapter_slug(first_chapter.timeline_position)}`,
      )
    : null;
  const timeline_href = with_base(`/rubedo/${book_slug}/timeline`);

  return {
    book_slug,
    book_title: book_entry?.title ?? book_slug,
    book_href,
    reader_href,
    timeline_href,
  };
});
---

<IndexLayout phase="rubedo" body_class="sol__pov_cinza">
  <rubedo data-shape="index_page">
    <PageHero title="Rubedo">
      <p>
        Finished work. Writing I am willing to put my name on, projects I
        consider my main goals. This is the seal.
      </p>
    </PageHero>

    <PageSection title="Works">
      <BookList books={book_links} />
    </PageSection>
  </rubedo>
</IndexLayout>
