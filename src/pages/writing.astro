---
import { SiteLayout, with_base } from "../site/index.ts";

const gates = [
  {
    name: "Nigredo",
    blurb:
      "The putrefaction: pieces written in moments of despair and delusion, moments that I barely remember when the sun rises.",
  },
  {
    name: "Albedo",
    blurb:
      "A clear lake: records and reflections from moments when the fog within settles, a rare moment of respite.",
  },
  {
    name: "Citrinitas",
    blurb:
      "A golden shelf: artifacts and references collected over the years, the only criteria is… making me smile.",
  },
  {
    name: "Rubedo",
    blurb: "My becoming. Work I want to be proud of.",
  },
];
---

<SiteLayout page_title="Writing">
  <h1>Writing</h1>
  <p>My amateur writing and practice.</p>
  <p>
    Unhinged late night ramblings, moments of clarity and hope, collections of
    poems and excerpts that make me keep walking forward… and maybe, just maybe,
    things I can be proud of.
  </p>
  <p>
    To open this drawer is to expose myself in ways that still make me terribly
    uncomfortable.
  </p>
  <p>But… I still have to show it.</p>
  <p>Nothing better than some exposure to get better, right?</p>
  <p>
    So… please. If you have any critiques, do send me a message… you can find my
    contact in the <strong><a href={with_base("about")}>About</a></strong> page.
  </p>
  <h2>The Four Gates</h2>
  <ul>
    {
      gates.map((gate) => (
        <li>
          <>
            <h3>{gate.name}</h3>
            <p>{gate.blurb}</p>
          </>
        </li>
      ))
    }
  </ul>
</SiteLayout>
