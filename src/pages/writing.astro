---
import IndexLayout from "../layouts/index.astro";
import PhaseCardGrid from "../components/home/phase_card_grid.astro";
import { with_base } from "../utils/routes.js";

const cinza_card_ornament_base = {
  corner_tl: with_base("ornaments/cinza/card_corner_a.svg"),
  corner_tr: with_base("ornaments/cinza/card_corner_b.svg"),
  corner_bl: with_base("ornaments/cinza/card_corner_c.svg"),
  corner_br: with_base("ornaments/cinza/card_corner_d.svg"),
  side_left: with_base("ornaments/cinza/card_side_flourish.svg"),
  side_right: with_base("ornaments/cinza/card_side_flourish.svg"),
};

const gate_visual = {
  ornament: {
    ...cinza_card_ornament_base,
    sigil: with_base("ornaments/cinza/sigil_eye.svg"),
  },
};

const phase_cards = [
  {
    phase_name: "Nigredo",
    phase_slug: "nigredo",
    phase_blurb:
      "The putrefaction: pieces written in moments of despair and delusion, moments that I barely remember when the sun rises.",
    ...gate_visual,
  },
  {
    phase_name: "Albedo",
    phase_slug: "albedo",
    phase_blurb:
      "A clear lake: records and reflections from moments when the fog within settles, a rare moment of respite.",
    ...gate_visual,
  },
  {
    phase_name: "Citrinitas",
    phase_slug: "citrinitas",
    phase_blurb:
      "A golden shelf: artifacts and references collected over the years, the only criteria is… making me smile.",
    ...gate_visual,
  },
  {
    phase_name: "Rubedo",
    phase_slug: "rubedo",
    phase_blurb: "My becoming. Work I want to be proud of.",
    ...gate_visual,
  },
];
---

<IndexLayout page_title="Writing" banner_title="Writing">
  <vessel data-shape="home_gate" id="sol_home_card_gate">
    <div id="sol_home_gate_intro">
      <div id="sol_home_gate_body">
        <p class="sol__home_intro_lead">
          My amateur <span
            class="sol__text_fx"
            data-text-fx="glow"
            data-text-fx-glow-intensity="0.75">writing</span
          > and <span
            class="sol__text_fx"
            data-text-fx="etch"
            data-text-fx-etch-intensity="0.65">practice</span
          >.
        </p>
        <p class="sol__home_intro_line">
          <span
            class="sol__text_fx"
            data-text-fx="glitch shadow"
            data-text-fx-glitch-intensity="0.6"
            data-text-fx-glitch-motion="0.55"
            data-text-fx-shadow-intensity="0.55">Unhinged</span
          > late night ramblings, moments of <span
            class="sol__text_fx"
            data-text-fx="aura"
            data-text-fx-aura-intensity="0.7">clarity</span
          > and <span
            class="sol__text_fx"
            data-text-fx="glow"
            data-text-fx-glow-intensity="0.7">hope</span
          >, collections of poems and excerpts that make me keep walking
          forward… and maybe, just maybe, things I can be proud of.
        </p>
        <p class="sol__home_intro_line">
          To open this drawer is to expose myself in ways that still make me
          terribly uncomfortable.
        </p>
        <p class="sol__home_intro_line">But… I still have to show it.</p>
        <p class="sol__home_intro_line">
          Nothing better than some exposure to get better, right?
        </p>
        <p class="sol__home_intro_line">
          So… please. If you have any critiques, do send me a message… you can
          find my contact in the <strong>About</strong> page.
        </p>
      </div>
    </div>

    <div id="sol_phase_card_header">
      <h2
        id="sol_phase_card_heading"
        class="sol__text_fx sol__text_fx_gradient sol__text_fx_aura"
        data-text-fx-intensity="0.85"
      >
        The Four Gates
      </h2>
    </div>

    <PhaseCardGrid phase_cards={phase_cards} />
  </vessel>
</IndexLayout>
