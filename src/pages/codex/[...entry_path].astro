---
import { getCollection, render } from "astro:content";
import IndexLayout from "../../layouts/index.astro";
import EntryDetail from "../../components/page/entry_detail.astro";
import LinkList from "../../components/page/link_list.astro";
import PageHero from "../../components/page/hero.astro";
import PageSection from "../../components/page/section.astro";
import { build_crumbs, with_base } from "../../utils/routes.js";

// Codex entries live in `obsidian/codex/`. The collection is path-routed:
// each .md file at `<category>/<sub>/<slug>.md` becomes the URL
// `/codex/<category>/<sub>/<slug>`.
//
// The entry id Astro gives us is the relative path without `.md` —
// matching our route param shape exactly. So `getStaticPaths` is a
// direct map: id → entry_path param.
//
// README.md and _template.md at the codex root are filtered out: their
// id forms would be `README` and `_template` (or in subdirs, similar)
// and they aren't real codex entries. We skip by filename stem.

export async function getStaticPaths() {
  // Inlined here because Astro hoists getStaticPaths and module-level
  // bindings declared in the same frontmatter aren't always reachable.
  const skip_stems = new Set(["readme", "_template"]);
  const entries = await getCollection("codex", ({ data, id }) => {
    if (data?.draft) return false;
    const stem = String(id).split("/").pop()?.toLowerCase() ?? "";
    if (skip_stems.has(stem)) return false;
    return true;
  });

  const entries_by_category = new Map();
  for (const entry of entries) {
    const segments = String(entry.id).split("/");
    if (segments.length < 2) continue;
    const [category] = segments;
    const category_entries = entries_by_category.get(category) ?? [];
    category_entries.push(entry);
    entries_by_category.set(category, category_entries);
  }

  const category_paths = [...entries_by_category.entries()].map(
    ([category_slug, category_entries]) => ({
      params: { entry_path: category_slug },
      props: { category_slug, category_entries },
    }),
  );

  return [
    ...category_paths,
    ...entries.map((entry) => ({
      params: { entry_path: entry.id },
      props: { entry },
    })),
  ];
}

const { entry, category_slug, category_entries = [] } = Astro.props;
const is_category_page = typeof category_slug === "string" && category_slug;
const { Content } = entry ? await render(entry) : { Content: null };

const entry_path = entry ? String(entry.id) : "";
const entry_segments = entry_path ? entry_path.split("/") : [];
const category_display_title = String(category_slug ?? "")
  .replace(/[-_]+/g, " ")
  .replace(/\b\w/g, (letter) => letter.toUpperCase());
const display_title =
  (typeof entry?.data?.title === "string" && entry.data.title.trim()) ||
  (typeof entry?.data?.slug === "string" && entry.data.slug.trim()) ||
  (entry_segments.at(-1) ?? entry_path);
const category_entry_links = category_entries
  .map((category_entry) => {
    const category_entry_path = String(category_entry.id);
    const category_entry_segments = category_entry_path.split("/");
    return {
      href: with_base(`/codex/${category_entry_path}`),
      label:
        (typeof category_entry.data?.title === "string" &&
          category_entry.data.title.trim()) ||
        (category_entry_segments.at(-1) ?? category_entry_path),
    };
  })
  .sort((left, right) => left.label.localeCompare(right.label));
const crumbs = is_category_page
  ? build_crumbs([
      { label: "codex", href: with_base("/codex") },
      { label: category_display_title, href: null },
    ])
  : build_crumbs([
      { label: "codex", href: with_base("/codex") },
      ...entry_segments.slice(0, -1).map((segment, idx) => ({
        label: segment,
        href: with_base(`/codex/${entry_segments.slice(0, idx + 1).join("/")}`),
      })),
      { label: display_title, href: null },
    ]);
---

<IndexLayout
  page_title={is_category_page ? category_display_title : display_title}
  phase="codex"
  crumbs={crumbs}
>
  {
    is_category_page ? (
      <codex data-shape="category_page">
        <PageHero title={category_display_title}>
          <p>Entries in the {category_display_title.toLowerCase()} category.</p>
        </PageHero>
        <PageSection title="Entries">
          <LinkList items={category_entry_links} />
        </PageSection>
      </codex>
    ) : (
      <codex data-shape="entry_detail">
        <EntryDetail title={display_title} lead={entry.data?.summary}>
          <Content />
        </EntryDetail>
      </codex>
    )
  }
</IndexLayout>
