---
import { getCollection, render } from "astro:content";
import IndexLayout from "../../layouts/index.astro";

// Codex entries live in `obsidian/codex/`. The collection is path-routed:
// each .md file at `<category>/<sub>/<slug>.md` becomes the URL
// `/codex/<category>/<sub>/<slug>`.
//
// The entry id Astro gives us is the relative path without `.md` —
// matching our route param shape exactly. So `getStaticPaths` is a
// direct map: id → entry_path param.
//
// README.md and _template.md at the codex root are filtered out: their
// id forms would be `README` and `_template` (or in subdirs, similar)
// and they aren't real codex entries. We skip by filename stem.

export async function getStaticPaths() {
  // Inlined here because Astro hoists getStaticPaths and module-level
  // bindings declared in the same frontmatter aren't always reachable
  // (see route-cache.js error: "SKIP_STEMS is not defined" when this
  // lived above the function).
  const skip_stems = new Set(["readme", "_template"]);
  const entries = await getCollection("codex", ({ data, id }) => {
    if (data?.draft) return false;
    const stem = String(id).split("/").pop()?.toLowerCase() ?? "";
    if (skip_stems.has(stem)) return false;
    return true;
  });
  return entries.map((entry) => ({
    params: { entry_path: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const base_path = import.meta.env.BASE_URL.replace(/\/+$/, "");
const entry_path = String(entry.id);
const entry_segments = entry_path.split("/");
const entry_category = entry_segments[0] ?? "";
const display_title =
  (typeof entry.data?.title === "string" && entry.data.title.trim()) ||
  (typeof entry.data?.slug === "string" && entry.data.slug.trim()) ||
  (entry_segments.at(-1) ?? entry_path);
const display_category =
  (typeof entry.data?.category === "string" && entry.data.category.trim()) ||
  entry_category;
---

<IndexLayout
  phase="codex"
  crumbs={[
    { label: "home", href: `${base_path}/` },
    { label: "codex", href: `${base_path}/codex` },
    ...entry_segments.slice(0, -1).map((segment, idx) => ({
      label: segment,
      href: `${base_path}/codex/${entry_segments.slice(0, idx + 1).join("/")}`,
    })),
    { label: display_title, href: null },
  ]}
>
  <codex data-shape="entry_detail">
    <div class="sol__entry_header">
      <p class="sol__text_kicker">~/ codex / {display_category}</p>
      <h1>{display_title}</h1>
      {
        entry.data?.summary && (
          <p class="sol__text_lead">{entry.data.summary}</p>
        )
      }
    </div>

    <div class="sol__entry_body sol__chapter_content">
      <Content />
    </div>
  </codex>
</IndexLayout>
