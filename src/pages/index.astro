---
import IndexLayout from "../layouts/index.astro";
import PhaseCardGrid from "../components/home/phase_card_grid.astro";
import { with_base } from "../utils/routes.js";
// home_card_gate.css moved to layout-level for htmx-nav availability

const cinza_card_ornament_base = {
  corner_tl: with_base("ornaments/cinza/card_corner_a.svg"),
  corner_tr: with_base("ornaments/cinza/card_corner_b.svg"),
  corner_bl: with_base("ornaments/cinza/card_corner_c.svg"),
  corner_br: with_base("ornaments/cinza/card_corner_d.svg"),
  side_left: with_base("ornaments/cinza/card_side_flourish.svg"),
  side_right: with_base("ornaments/cinza/card_side_flourish.svg"),
};

const nigredo_card_visual = {
  ornament: {
    ...cinza_card_ornament_base,
    sigil: with_base("ornaments/cinza/sigil_eye.svg"),
  },
};

const phase_cards = [
  {
    phase_name: "Nigredo",
    phase_slug: "nigredo",
    phase_blurb:
      "Dissolution and shadow-work. Enter the black vessel of becoming.",
    ...nigredo_card_visual,
  },
  {
    phase_name: "Albedo",
    phase_slug: "albedo",
    phase_blurb: "Clarification and silver breath. Distill signal from noise.",
    ...nigredo_card_visual,
  },
  {
    phase_name: "Citrinitas",
    phase_slug: "citrinitas",
    phase_blurb: "Dawn-gold awakening. Let meaning crystallize into form.",
    ...nigredo_card_visual,
  },
  {
    phase_name: "Rubedo",
    phase_slug: "rubedo",
    phase_blurb: "Union and embodiment. Seal the work in living fire.",
    ...nigredo_card_visual,
  },
];
---

<IndexLayout page_title="Our Hearth" hide_breadcrumbs={true}>
  <vessel data-shape="home_gate" id="sol_home_card_gate">
    <div id="sol_home_gate_intro">
      <div id="sol_home_gate_header">
        <h1 id="sol_home_gate_title">
          <span
            class="sol__text_fx sol__text_fx_gradient sol__text_fx_aura sol__text_fx_glow"
            data-text-fx-intensity="1.25"
          >
            Our Hearth
          </span>
        </h1>
      </div>

      <div id="sol_home_gate_body">
        <p class="sol__home_intro_lead">
          A hearth for
          <span class="sol__text_fx sol__text_fx_glow" data-text-fx-intensity="1.1">
            worlds
          </span>,
          <span class="sol__text_fx sol__text_fx_sigil_pulse" data-text-fx-intensity="0.9">
            tools
          </span>,
          records, experiments, and the strange work that refuses to become one
          tidy thing.
        </p>

        <p class="sol__home_intro_line">
          Not a funnel. Not a single project pretending to behave. A living
          shelf for games, writing, software, the channel, and whatever starts
          glowing next.
        </p>

        <p class="sol__home_intro_hint">
          The gates below are only one map through the archive.
        </p>
      </div>
    </div>

    <PhaseCardGrid phase_cards={phase_cards} />
  </vessel>
</IndexLayout>
