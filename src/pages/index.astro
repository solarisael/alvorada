---
import IndexLayout from "../layouts/index.astro";
import PhaseCardGrid from "../components/home/phase_card_grid.astro";
import { with_base } from "../utils/routes.js";
// home_card_gate.css moved to layout-level for htmx-nav availability

const cinza_card_ornament_base = {
  corner_tl: with_base("ornaments/cinza/card_corner_a.svg"),
  corner_tr: with_base("ornaments/cinza/card_corner_b.svg"),
  corner_bl: with_base("ornaments/cinza/card_corner_c.svg"),
  corner_br: with_base("ornaments/cinza/card_corner_d.svg"),
  side_left: with_base("ornaments/cinza/card_side_flourish.svg"),
  side_right: with_base("ornaments/cinza/card_side_flourish.svg"),
};

const nigredo_card_visual = {
  ornament: {
    ...cinza_card_ornament_base,
    sigil: with_base("ornaments/cinza/sigil_eye.svg"),
  },
};

const phase_cards = [
  {
    phase_name: "Writing",
    phase_slug: "writing",
    phase_blurb:
      "Poems, fragments, essays, books, and the four alchemical gates through the written body.",
    visual_phase_slug: "nigredo",
    ...nigredo_card_visual,
  },
  {
    phase_name: "Work",
    phase_slug: "work",
    phase_blurb:
      "Original tools, enormous systems, and the things I have built for people beyond this room.",
    visual_phase_slug: "citrinitas",
    ...nigredo_card_visual,
  },
  {
    phase_name: "About",
    phase_slug: "about",
    phase_blurb:
      "The creature tending the hearth, what Solarisael is, and how to find me.",
    visual_phase_slug: "rubedo",
    ...nigredo_card_visual,
  },
];
---

<IndexLayout
  page_title="Our Hearth"
  banner_title="Solarisael"
  hide_breadcrumbs={true}
>
  <vessel data-shape="home_gate" id="sol_home_card_gate">
    <div id="sol_home_gate_intro">
      <div id="sol_home_gate_body">
        <p class="sol__home_intro_lead">
          A small space for my <span
            class="sol__text_fx sol__text_fx_glow sol__text_fx_neon"
            data-text-fx-intensity="5.0">work</span
          >, <span
            class="sol__text_fx sol__text_fx_glow"
            data-text-fx-intensity="1.5">my thoughts</span
          >, records, experiments, and the strange work that refuses to become
          one tidy thing.
        </p>

        <p class="sol__home_intro_line">
          Not a funnel. Not a single project pretending to behave. A living
          shelf for games, writing, software, the channel, and whatever starts
          glowing next.
        </p>

        <p class="sol__home_intro_hint">Choose a wing.</p>

        <p
          class="sol__home_chalice_text"
          data-sol-pretext="justify"
          data-sol-pretext-shape="chalice"
        >
          A cup of small fires holds below the threshold; the work pours through
          it, narrows to a stem, and opens again where the gates begin.
        </p>
      </div>
    </div>

    <div id="sol_phase_card_header">
      <h2
        id="sol_phase_card_heading"
        class="sol__text_fx sol__text_fx_gradient sol__text_fx_aura"
        data-text-fx-intensity="0.85"
      >
        Three Wings
      </h2>
    </div>

    <PhaseCardGrid phase_cards={phase_cards} />
  </vessel>
</IndexLayout>
