---
import IndexLayout from "../../layouts/index.astro";

export const getStaticPaths = () => {
  return [
    { params: { post_slug: "first-lantern" } },
    { params: { post_slug: "midnight-notes" } },
    { params: { post_slug: "ritual-of-clarity" } },
  ];
};

const post_slug = Astro.params.post_slug ?? "unknown-post";
const base_url = import.meta.env.BASE_URL;
const base_path = base_url.replace(/\/+$/, "");
const with_base = (path_value) => {
  const normalized_path = String(path_value).replace(/^\/+/, "");

  return `${base_path}/${normalized_path}`;
};
---

<IndexLayout>
  <albedo data-shape="entry_detail">
    <div class="sol__entry_header">
      <p>~/ albedo / {post_slug}</p>
      <h1>Albedo Post</h1>
    </div>

    <div class="sol__entry_body">
      <p>
        Scaffold child page for <code>/albedo/{post_slug}</code>. Use this to
        verify nested breadcrumbs and HTMX transition behavior.
      </p>
      <p>
        <a
          href={with_base("/albedo")}
          hx-get={with_base("/albedo")}
          hx-target="#sol_content"
          hx-select="#sol_content"
          hx-swap="morph swap:240ms settle:240ms"
          hx-push-url="true">Back to Albedo index</a
        >
      </p>
    </div>
  </albedo>
</IndexLayout>
