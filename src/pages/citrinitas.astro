---
import IndexLayout from "../layouts/index.astro";

const sample_post_slugs = ["sun-archive", "golden-fragments", "glass-garden"];
const base_url = import.meta.env.BASE_URL;
const base_path = base_url.replace(/\/+$/, "");
const with_base = (path_value) => {
  const normalized_path = String(path_value).replace(/^\/+/, "");

  return `${base_path}/${normalized_path}`;
};
---

<IndexLayout>
  <section>
    <article>
      <header>
        <p>~/ citrinitas</p>
        <h1>Citrinitas</h1>
      </header>

      <div>
        <p>
          Scaffold page for <code>/citrinitas</code>. Choose a sample child post
          to validate transition and breadcrumb depth.
        </p>

        {
          sample_post_slugs.map((post_slug) => (
            <p>
              <a href={with_base(`/citrinitas/${post_slug}`)}>
                Open post: {post_slug}
              </a>
            </p>
          ))
        }
      </div>
    </article>
  </section>
</IndexLayout>
