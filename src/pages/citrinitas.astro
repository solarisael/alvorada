---
import { getCollection } from "astro:content";
import IndexLayout from "../layouts/index.astro";

const base_path = import.meta.env.BASE_URL.replace(/\/+$/, "");

// Citrinitas entries land in the Obsidian vault at `zzz_citrinitas/`. Schema
// in `content.config.js` is intentionally loose — tighten once Sol's pattern
// surfaces in real entries.
const raw_entries = await getCollection(
  "citrinitas",
  ({ data }) => !data.draft,
);

const archive_index = raw_entries
  .sort((a, b) => b.data.published_at.localeCompare(a.data.published_at))
  .map((entry) => ({
    slug: entry.data.slug,
    title: entry.data.title ?? null,
    published_at: entry.data.published_at,
    excerpt: entry.data.excerpt ?? null,
    featured: entry.data.featured ?? false,
    href: `${base_path}/citrinitas/${entry.data.slug}`,
  }));
---

<IndexLayout phase="citrinitas">
  <citrinitas data-shape="archive_page">
    <div class="sol__page_hero">
      <p class="sol__text_kicker">~/ citrinitas</p>
      <p class="sol__text_kicker">03</p>
      <h1>Citrinitas</h1>
      <p>
        Archives of things that landed. Moments, photos, records. The collection
        of what I am actually proud of.
      </p>
    </div>

    <div class="sol__page_section">
      <h2>Archives &amp; Moments</h2>
      {
        archive_index.length === 0 ? (
          <p class="sol__text_fine">Nothing archived yet.</p>
        ) : (
          <ul class="sol__archive_list">
            {archive_index.map((entry) => (
              <li>
                <a
                  href={entry.href}
                  hx-get={entry.href}
                  hx-target="#sol_content"
                  hx-select="#sol_content"
                  hx-swap="morph swap:240ms settle:240ms"
                  hx-push-url="true"
                >
                  <time datetime={entry.published_at} class="sol__text_kicker">
                    {entry.published_at}
                  </time>
                  <span>{entry.title ?? entry.slug}</span>
                </a>
                {entry.excerpt && <p class="sol__text_fine">{entry.excerpt}</p>}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </citrinitas>
</IndexLayout>
