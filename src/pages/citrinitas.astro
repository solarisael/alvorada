---
import { getCollection } from "astro:content";
import IndexLayout from "../layouts/index.astro";
import ArchiveList from "../components/page/archive_list.astro";
import PageHero from "../components/page/hero.astro";
import PageSection from "../components/page/section.astro";
import { with_base } from "../utils/routes.js";

// Citrinitas entries land in the Obsidian vault at `zzz_citrinitas/`. Schema
// in `content.config.js` is intentionally loose — tighten once Sol's pattern
// surfaces in real entries.
const raw_entries = await getCollection(
  "citrinitas",
  ({ data }) => !data.draft,
);

const archive_index = raw_entries
  .sort((a, b) => b.data.published_at.localeCompare(a.data.published_at))
  .map((entry) => ({
    slug: entry.data.slug,
    title: entry.data.title ?? null,
    published_at: entry.data.published_at,
    excerpt: entry.data.excerpt ?? null,
    featured: entry.data.featured ?? false,
    href: with_base(`/citrinitas/${entry.data.slug}`),
  }));
---

<IndexLayout phase="citrinitas">
  <citrinitas data-shape="archive_page">
    <PageHero title="Citrinitas">
      <p>
        Archives of things that landed. Moments, photos, records. The collection
        of what I am actually proud of.
      </p>
    </PageHero>

    <PageSection title="Archives & Moments">
      <ArchiveList entries={archive_index} empty_text="Nothing archived yet." />
    </PageSection>
  </citrinitas>
</IndexLayout>
