---
import IndexLayout from "../layouts/index.astro";
import ContentLink from "../components/page/content_link.astro";
import PageHero from "../components/page/hero.astro";
import { citrinitas_gallery } from "../data/citrinitas/booklet_runtime.js";
import { citrinitas_booklet_path } from "../data/citrinitas/route_data.js";
import { with_base } from "../utils/routes.js";
// citrinitas_page.css hoisted to layout-level for htmx-nav availability

// Each booklet links to its landing page; the masonry size drives the grid
// span via data-size (resolved to span tokens in citrinitas_page.css).
const booklets = citrinitas_gallery.map((booklet) => ({
  ...booklet,
  href: with_base(citrinitas_booklet_path(booklet.book_slug)),
  cover_src: booklet.cover ? with_base(booklet.cover) : null,
}));
---

<IndexLayout phase="citrinitas" page_title="Citrinitas">
  <citrinitas data-shape="gallery_page">
    <PageHero title="Citrinitas">
      <p class="sol__text_lead">
        The yellowing — the dark turned to fuel, not denied. Contained works,
        booklets, the things that landed. What I am actually proud of.
      </p>
    </PageHero>

    {
      booklets.length === 0 ? (
        <p class="sol__citrinitas_empty">
          No booklets yet. The garden is young.
        </p>
      ) : (
        <citrinitas data-shape="masonry" class="sol__citrinitas_masonry">
          {booklets.map((booklet) => (
            <ContentLink
              href={booklet.href}
              class="sol__citrinitas_card"
              data-size={booklet.size}
            >
              <article class="sol__citrinitas_card_inner">
                {booklet.cover_src && (
                  <img
                    class="sol__citrinitas_card_cover"
                    src={booklet.cover_src}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="sol__citrinitas_card_body">
                  <h2 class="sol__citrinitas_card_title">{booklet.title}</h2>
                  {booklet.synopsis && (
                    <p class="sol__citrinitas_card_synopsis">
                      {booklet.synopsis}
                    </p>
                  )}
                  <span class="sol__citrinitas_card_count sol__text_kicker">
                    {booklet.chapter_count}{" "}
                    {booklet.chapter_count === 1 ? "piece" : "pieces"}
                  </span>
                </div>
              </article>
            </ContentLink>
          ))}
        </citrinitas>
      )
    }
  </citrinitas>
</IndexLayout>
