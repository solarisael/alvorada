---
import { getCollection, render } from "astro:content";
import IndexLayout from "../../layouts/index.astro";
import NigredoPill from "../../components/nigredo/pill.astro";
import "../../styles/components/nigredo_page.css";

export async function getStaticPaths() {
  const entries = await getCollection("nigredo", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { entry_slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const primary_state = entry.data.states[0];
const base_path = import.meta.env.BASE_URL.replace(/\/+$/, "");

function redact_length(slug) {
  let hash = 0;
  for (let i = 0; i < slug.length; i++) {
    hash = (hash * 31 + slug.charCodeAt(i)) >>> 0;
  }
  return 4 + (hash % 9);
}

const display_title = entry.data.title
  ? entry.data.title
  : "■".repeat(redact_length(entry.data.slug));
---

<IndexLayout
  phase="nigredo"
  crumbs={[
    { label: "home", href: `${base_path}/` },
    { label: "nigredo", href: `${base_path}/nigredo` },
    { label: display_title, href: null },
  ]}
>
  <nigredo data-shape="entry_detail" class="sol__nigredo_detail">
    <div class="sol__nigredo_detail_header">
      <div class="sol__nigredo_detail_meta">
        <NigredoPill state={primary_state} />
        <time class="sol__nigredo_entry_date" datetime={entry.data.published_at}>
          {entry.data.published_at}
        </time>
      </div>
      <h1 class="sol__nigredo_detail_title" data-redacted={!entry.data.title}>
        {display_title}
      </h1>
    </div>

    <div class="sol__nigredo_detail_body sol__chapter_content">
      <Content />
    </div>
  </nigredo>
</IndexLayout>

<style>
  .sol__nigredo_detail {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sol__nigredo_detail_header {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid
      color-mix(in oklch, var(--site_style_accent) 16%, transparent);
  }

  .sol__nigredo_detail_meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .sol__nigredo_detail_title {
    font-size: var(--text_h1, 1.75rem);
    font-family: var(--font_reading_heading);
    font-weight: 500;
    line-height: 1.2;
    color: oklch(88% 0.014 258);
    margin: 0;
  }

  .sol__nigredo_detail_title[data-redacted="true"] {
    letter-spacing: 0.08em;
    color: oklch(36% 0.01 258);
    font-family: monospace;
  }

  .sol__nigredo_detail_body {
    max-width: 62ch;
  }
</style>
