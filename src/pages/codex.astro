---
import IndexLayout from "../layouts/index.astro";

const sample_entry_paths = [
  "characters/sol",
  "characters/luna",
  "factions/order-of-dawn",
  "places/astral-garden",
  "relics/first-lantern",
];

const sample_category_paths = ["characters", "factions", "places", "relics"];
const base_url = import.meta.env.BASE_URL;
const base_path = base_url.replace(/\/+$/, "");
const with_base = (path_value) => {
  const normalized_path = String(path_value).replace(/^\/+/, "");

  return `${base_path}/${normalized_path}`;
};
---

<IndexLayout>
  <section>
    <article>
      <header>
        <p>~/ codex</p>
        <h1>Codex</h1>
      </header>

      <div>
        <p>
          Scaffold page for <code>/codex</code>. Choose a sample entry path to
          test variable-depth codex routing.
        </p>

        {
          sample_category_paths.map((category_path) => (
            <p>
              <a
                href={with_base(`/codex/${category_path}`)}
                hx-get={with_base(`/codex/${category_path}`)}
                hx-target="#content"
                hx-select="#content"
                hx-swap="morph swap:240ms settle:240ms"
                hx-push-url="true"
              >
                Open category: {category_path}
              </a>
            </p>
          ))
        }

        {
          sample_entry_paths.map((entry_path) => (
            <p>
              <a
                href={with_base(`/codex/${entry_path}`)}
                hx-get={with_base(`/codex/${entry_path}`)}
                hx-target="#content"
                hx-select="#content"
                hx-swap="morph swap:240ms settle:240ms"
                hx-push-url="true"
              >
                Open entry: {entry_path}
              </a>
            </p>
          ))
        }
      </div>
    </article>
  </section>
</IndexLayout>
