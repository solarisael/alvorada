---
import IndexLayout from "../layouts/index.astro";

const categories = [
  { slug: "characters", label: "Characters" },
  { slug: "factions", label: "Factions" },
  { slug: "places", label: "Places" },
  { slug: "relics", label: "Relics" },
];

const labs = [
  { slug: "labs/test-texts", label: "Text Effects Sandbox" },
  { slug: "labs/test-overlays", label: "Overlay Sandbox" },
];

const base_url = import.meta.env.BASE_URL;
const base_path = base_url.replace(/\/+$/, "");
const with_base = (path_value) => {
  const normalized_path = String(path_value).replace(/^\/+/, "");

  return `${base_path}/${normalized_path}`;
};
---

<IndexLayout phase="codex">
  <codex data-shape="index_page">
    <div class="page-hero">
      <p class="text_kicker">~/ codex</p>
      <p class="text_kicker">05</p>
      <h1>Codex</h1>
      <p>
        The lore index. Everything on this site that has a name, a category, or
        a definition lives here. Entries can be cross-referenced by any page —
        hover a reference to see the entry inline.
      </p>
    </div>

    <div class="page-section">
      <h2>Categories</h2>

      {
        categories.map((category) => (
          <p>
            <a
              href={with_base(`/codex/${category.slug}`)}
              hx-get={with_base(`/codex/${category.slug}`)}
              hx-target="#sol_content"
              hx-select="#sol_content"
              hx-swap="morph swap:240ms settle:240ms"
              hx-push-url="true"
            >
              {category.label}
            </a>
          </p>
        ))
      }
    </div>

    <div class="page-section">
      <h2>Labs</h2>

      {
        labs.map((lab) => (
          <p>
            <a
              href={with_base(`/codex/${lab.slug}`)}
              hx-get={with_base(`/codex/${lab.slug}`)}
              hx-target="#sol_content"
              hx-select="#sol_content"
              hx-swap="morph swap:240ms settle:240ms"
              hx-push-url="true"
            >
              {lab.label}
            </a>
          </p>
        ))
      }
    </div>
  </codex>
</IndexLayout>
