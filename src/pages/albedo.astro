---
import { getCollection, render } from "astro:content";
import IndexLayout from "../layouts/index.astro";
import AlbedoList from "../components/albedo/list.astro";
import PageHero from "../components/page/hero.astro";
import { with_base } from "../utils/routes.js";
import { derive_albedo_entry_view } from "../utils/albedo_feed.js";
// albedo_page.css hoisted to layout-level for htmx-nav availability

const raw_entries = await getCollection("albedo", ({ data }) => !data.draft);

const archive_index = await Promise.all(
  raw_entries
    .sort((a, b) => b.data.published_at.localeCompare(a.data.published_at))
    .map(async (entry, index) => {
      const { Content } = await render(entry);
      const view = derive_albedo_entry_view({
        body: entry.body,
        data: entry.data,
        href: with_base(`/albedo/${entry.data.slug}`),
        index,
      });

      return { ...view, Content };
    }),
);
---

<IndexLayout phase="albedo">
  <albedo data-shape="archive_page">
    <PageHero title="Albedo">
      <p class="sol__text_lead">
        The thoughts that reached the other side. Washed, composed, occasionally
        hopeful — what stays once the dark has settled.
      </p>
    </PageHero>

    <AlbedoList archive_index={archive_index} />
  </albedo>
</IndexLayout>