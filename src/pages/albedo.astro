---
import IndexLayout from "../layouts/index.astro";

const sample_post_slugs = [
  "first-lantern",
  "midnight-notes",
  "ritual-of-clarity",
];
const base_url = import.meta.env.BASE_URL;
const base_path = base_url.replace(/\/+$/, "");
const with_base = (path_value) => {
  const normalized_path = String(path_value).replace(/^\/+/, "");

  return `${base_path}/${normalized_path}`;
};
---

<IndexLayout>
  <section>
    <article>
      <header>
        <p>~/ albedo</p>
        <h1>Albedo</h1>
      </header>

      <div>
        <p>
          Scaffold page for <code>/albedo</code>. Choose a sample child post to
          test nested breadcrumb hierarchy.
        </p>

        {
          sample_post_slugs.map((post_slug) => (
            <p>
              <a
                href={with_base(`/albedo/${post_slug}`)}
                hx-get={with_base(`/albedo/${post_slug}`)}
                hx-target="#content"
                hx-select="#content"
                hx-swap="morph swap:240ms settle:240ms"
                hx-push-url="true"
              >
                Open post: {post_slug}
              </a>
            </p>
          ))
        }
      </div>
    </article>
  </section>
</IndexLayout>
