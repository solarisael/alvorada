---
import { getCollection, render } from "astro:content";
import IndexLayout from "../layouts/index.astro";
import NigredoList from "../components/nigredo/list.astro";
import "../styles/components/nigredo_page.css";

const base_path = import.meta.env.BASE_URL.replace(/\/+$/, "");

// Build the thin archive index from frontmatter only
const raw_entries = await getCollection("nigredo", ({ data }) => !data.draft);

const archive_index = raw_entries
  .sort((a, b) => b.data.published_at.localeCompare(a.data.published_at))
  .map((entry) => {
    // Excerpt: frontmatter first, body first-paragraph fallback handled client-side
    // We pass excerpt from frontmatter; JS module uses it directly.
    return {
      slug: entry.data.slug,
      title: entry.data.title ?? null,
      published_at: entry.data.published_at,
      states: entry.data.states,
      excerpt: entry.data.excerpt ?? null,
      featured: entry.data.featured ?? false,
      href: `${base_path}/nigredo/${entry.data.slug}`,
    };
  });
---

<IndexLayout phase="nigredo">
  <nigredo data-shape="archive_page">
    <div class="page-hero">
      <p class="sol__text_kicker">~/ nigredo</p>
      <h1>Nigredo</h1>
      <p class="sol__text_lead">
        Uncut. No audience. No revision. The thought before it learns to behave.
      </p>
    </div>

    <NigredoList archive_index={archive_index} base_path={base_path} />
  </nigredo>
</IndexLayout>
