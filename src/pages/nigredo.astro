---
import IndexLayout from "../layouts/index.astro";

const base_url = import.meta.env.BASE_URL;
---

<IndexLayout>
  <section>
    <article>
      <header>
        <p>~/ nigredo</p>
        <h1>Nigredo</h1>
      </header>

      <div>
        <p>
          Scaffold page for <code>/nigredo</code>. This route exists to validate
          direct navigation and HTMX swaps separately from <code>/</code>.
        </p>
        <p>
          <a
            href={base_url}
            hx-get={base_url}
            hx-target="#content"
            hx-select="#content"
            hx-swap="morph swap:240ms settle:240ms"
            hx-push-url="true">Return to Home</a
          >
        </p>
      </div>
    </article>
  </section>
</IndexLayout>
