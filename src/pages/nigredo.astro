---
import { getCollection, render } from "astro:content";
import IndexLayout from "../layouts/index.astro";
import NigredoList from "../components/nigredo/list.astro";
import PageHero from "../components/page/hero.astro";
import { with_base } from "../utils/routes.js";
import { derive_nigredo_entry_view } from "../utils/nigredo_feed.js";
// nigredo_page.css moved to layout-level for htmx-nav availability

const raw_entries = await getCollection("nigredo", ({ data }) => !data.draft);

const archive_index = await Promise.all(
  raw_entries
    .sort((a, b) => b.data.published_at.localeCompare(a.data.published_at))
    .map(async (entry, index) => {
      const { Content } = await render(entry);
      const view = derive_nigredo_entry_view({
        body: entry.body,
        data: entry.data,
        href: with_base(`/nigredo/${entry.data.slug}`),
        index,
      });

      return { ...view, Content };
    }),
);
---

<IndexLayout phase="nigredo">
  <nigredo data-shape="archive_page">
    <PageHero title="Nigredo">
      <p class="sol__text_lead">
        Uncut. No audience. No revision. The thought before it learns to behave.
      </p>
    </PageHero>

    <NigredoList archive_index={archive_index} />
  </nigredo>
</IndexLayout>
