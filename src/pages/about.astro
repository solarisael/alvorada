---
import IndexLayout from "../layouts/index.astro";

const profile = [
  ["Name", "Solarisael"],
  ["Callsign", "Sol"],
  ["Class", "Developer · Writer · Worldbuilder"],
  ["Experience", "Almost two decades"],
];

const traits = ["systems thinking", "strange software", "mythmaking", "black sheep persistence"];
---

<IndexLayout page_title="About" phase="about" banner_title="Character Sheet 001">
  <article class="character-sheet" aria-labelledby="character-name">
    <div class="character-sheet__frame character-sheet__frame--outer" aria-hidden="true">
      <span class="character-sheet__corner character-sheet__corner--tl">✦</span>
      <span class="character-sheet__corner character-sheet__corner--tr">✦</span>
      <span class="character-sheet__corner character-sheet__corner--bl">✦</span>
      <span class="character-sheet__corner character-sheet__corner--br">✦</span>
    </div>
    <div class="character-sheet__frame character-sheet__frame--inner" aria-hidden="true"></div>
    <header class="character-sheet__masthead">
      <div>
        <p class="character-sheet__eyebrow">Personal archive · specimen 001</p>
        <h1 id="character-name">Solarisael</h1>
        <p class="character-sheet__alias">Known to friends as <strong>Sol</strong></p>
      </div>
      <p class="character-sheet__mark" aria-label="Status: still becoming">Still<br />becoming</p>
    </header>

    <div class="character-sheet__body" data-sol-pretext-composition>
      <section class="character-sheet__column character-sheet__column--left" aria-label="Identity">
        <div class="dossier-card dossier-card--profile">
          <p class="dossier-card__number">01 / Identity</p>
          <dl>
            {profile.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="dossier-card dossier-card--quote">
          <p class="dossier-card__number">02 / Prime directive</p>
          <blockquote data-pretext-flow data-flow-side="left">
            Change the world so fewer people feel the desperation I knew.
          </blockquote>
        </div>
      </section>

      <figure class="character-sheet__portrait">
        <img
          src={`${import.meta.env.BASE_URL}/images/solarisaeia_character_transparent.png`}
          alt="Solarisael, a black horned figure wrapped in a pale mantle"
        />
        <figcaption>
          <span>Solarisaeia</span>
          <small>the shape at the edge of the water</small>
        </figcaption>
      </figure>

      <section class="character-sheet__column character-sheet__column--right" aria-label="Practice">
        <div class="dossier-card dossier-card--practice">
          <p class="dossier-card__number">03 / Practice</p>
          <p data-pretext-flow data-flow-side="right">
            I build software, stories, and systems that make difficult things
            legible without sanding away their strangeness.
          </p>
          <p data-pretext-flow data-flow-side="right">
            Code has been part of my life for almost two decades. This site is
            where the technical work and the mythic work are finally allowed to
            belong to the same person.
          </p>
        </div>

        <div class="dossier-card dossier-card--traits">
          <p class="dossier-card__number">04 / Known traits</p>
          <ul>
            {traits.map((trait) => <li>{trait}</li>)}
          </ul>
        </div>
      </section>

      <div class="character-sheet__flow" aria-hidden="true"></div>
    </div>

    <footer class="character-sheet__footer">
      <p><span>Alignment</span> Ternary in a binary world</p>
      <p><span>Current quest</span> Build what should already exist</p>
      <p class="character-sheet__seal">Black sheep / black sun</p>
    </footer>
  </article>
</IndexLayout>

<script>
  import { layoutNextLine, prepareWithSegments, type LayoutCursor } from "@chenglou/pretext";

  type AlphaInterval = [left: number, right: number] | null;
  type FlowSide = "left" | "right";

  let alphaRows: AlphaInterval[] = [];
  let alphaWidth = 0;
  let alphaHeight = 0;

  const readAlphaHull = (image: HTMLImageElement) => {
    if (alphaRows.length > 0 && alphaWidth === image.naturalWidth) return;

    const canvas = document.createElement("canvas");
    canvas.width = image.naturalWidth;
    canvas.height = image.naturalHeight;
    const context = canvas.getContext("2d", { willReadFrequently: true });
    if (!context) return;
    context.drawImage(image, 0, 0);
    const pixels = context.getImageData(0, 0, canvas.width, canvas.height).data;

    alphaWidth = canvas.width;
    alphaHeight = canvas.height;
    alphaRows = Array.from({ length: alphaHeight }, (_, y) => {
      let left = alphaWidth;
      let right = -1;
      for (let x = 0; x < alphaWidth; x += 1) {
        if (pixels[(y * alphaWidth + x) * 4 + 3] <= 12) continue;
        left = Math.min(left, x);
        right = Math.max(right, x);
      }
      return right >= left ? [left, right] : null;
    });
  };

  const cardText = (card: HTMLElement) => {
    if (card.classList.contains("dossier-card--profile")) {
      return [...card.querySelectorAll("dl > div")]
        .map((row) => {
          const label = row.querySelector("dt")?.textContent?.trim();
          const value = row.querySelector("dd")?.textContent?.trim();
          return `${label}: ${value}`;
        })
        .join(" · ");
    }

    if (card.classList.contains("dossier-card--traits")) {
      return [...card.querySelectorAll("li")]
        .map((item) => item.textContent?.trim())
        .filter(Boolean)
        .join(" · ");
    }

    return [...card.querySelectorAll("blockquote, p:not(.dossier-card__number)")]
      .map((element) => element.textContent?.replace(/\s+/g, " ").trim())
      .filter(Boolean)
      .join(" ");
  };

  const blockedInterval = (
    rootRect: DOMRect,
    imageRect: DOMRect,
    lineTop: number,
    lineHeight: number,
  ): AlphaInterval => {
    const absoluteTop = rootRect.top + lineTop;
    const absoluteBottom = absoluteTop + lineHeight;
    if (absoluteBottom <= imageRect.top || absoluteTop >= imageRect.bottom) return null;

    const firstRow = Math.max(0, Math.floor(((absoluteTop - imageRect.top) / imageRect.height) * alphaHeight));
    const lastRow = Math.min(
      alphaHeight - 1,
      Math.ceil(((absoluteBottom - imageRect.top) / imageRect.height) * alphaHeight),
    );
    let left = alphaWidth;
    let right = -1;
    for (let row = firstRow; row <= lastRow; row += 1) {
      const interval = alphaRows[row];
      if (!interval) continue;
      left = Math.min(left, interval[0]);
      right = Math.max(right, interval[1]);
    }
    if (right < left) return null;

    const imageLeft = imageRect.left - rootRect.left;
    return [
      imageLeft + (left / alphaWidth) * imageRect.width - 12,
      imageLeft + ((right + 1) / alphaWidth) * imageRect.width + 12,
    ];
  };

  const slotForLine = (
    side: FlowSide,
    rootRect: DOMRect,
    imageRect: DOMRect,
    y: number,
    lineHeight: number,
  ) => {
    const pageInset = 12;
    const blocked = blockedInterval(rootRect, imageRect, y, lineHeight);
    if (!blocked) return { left: pageInset, right: rootRect.width - pageInset };
    return side === "left"
      ? { left: pageInset, right: Math.min(rootRect.width - pageInset, blocked[0]) }
      : { left: Math.max(pageInset, blocked[1]), right: rootRect.width - pageInset };
  };

  const renderBlock = (
    layer: HTMLElement,
    card: HTMLElement,
    side: FlowSide,
    startY: number,
    rootRect: DOMRect,
    imageRect: DOMRect,
  ) => {
    if (card.classList.contains("dossier-card--profile")) {
      let y = startY;
      let slot = slotForLine(side, rootRect, imageRect, y, 18);
      while (slot.right - slot.left < 96) {
        y += 18;
        slot = slotForLine(side, rootRect, imageRect, y, 18);
      }

      const heading = document.createElement("span");
      heading.className = "pretext-float-heading";
      heading.textContent = card.querySelector(".dossier-card__number")?.textContent?.trim() ?? "";
      Object.assign(heading.style, {
        left: `${slot.left}px`,
        top: `${y}px`,
        width: `${slot.right - slot.left}px`,
      });
      layer.append(heading);
      y += 23;

      card.querySelectorAll("dl > div").forEach((row) => {
        let fieldSlot = slotForLine(side, rootRect, imageRect, y, 34);
        while (fieldSlot.right - fieldSlot.left < 84) {
          y += 17;
          fieldSlot = slotForLine(side, rootRect, imageRect, y, 34);
        }

        const field = document.createElement("span");
        field.className = "pretext-float-field";
        const label = document.createElement("span");
        label.className = "pretext-float-field__label";
        label.textContent = row.querySelector("dt")?.textContent?.trim() ?? "";
        const value = document.createElement("span");
        value.className = "pretext-float-field__value";
        value.textContent = row.querySelector("dd")?.textContent?.trim() ?? "";
        field.append(label, value);
        Object.assign(field.style, {
          left: `${fieldSlot.left}px`,
          top: `${y}px`,
          width: `${fieldSlot.right - fieldSlot.left}px`,
        });
        layer.append(field);
        y += Math.max(42, field.getBoundingClientRect().height + 8);
      });
      return;
    }

    const source = cardText(card);
    const sample = card.querySelector("dd, blockquote, p:not(.dossier-card__number), li");
    const styles = getComputedStyle(sample ?? card);
    const lineHeight = Math.max(15, Number.parseFloat(styles.lineHeight) || 20);
    const font = `${styles.fontStyle} ${styles.fontWeight} ${styles.fontSize} ${styles.fontFamily}`;
    const prepared = prepareWithSegments(source, font, { whiteSpace: "pre-wrap" });
    let cursor: LayoutCursor = { segmentIndex: 0, graphemeIndex: 0 };
    let y = startY;
    let headingRendered = false;

    for (let guard = 0; guard < 120; guard += 1) {
      const slot = slotForLine(side, rootRect, imageRect, y, lineHeight);
      const width = slot.right - slot.left;
      if (width < 72) {
        y += lineHeight;
        continue;
      }

      if (!headingRendered) {
        const heading = document.createElement("span");
        heading.className = "pretext-float-heading";
        heading.textContent = card.querySelector(".dossier-card__number")?.textContent?.trim() ?? "";
        Object.assign(heading.style, {
          left: `${slot.left}px`,
          top: `${y}px`,
          width: `${width}px`,
        });
        layer.append(heading);
        y += 22;
        headingRendered = true;
        continue;
      }

      const line = layoutNextLine(prepared, cursor, width);
      if (line === null) break;
      const span = document.createElement("span");
      span.className = "pretext-float-line";
      span.textContent = line.text;
      Object.assign(span.style, {
        left: `${slot.left}px`,
        top: `${y}px`,
        font,
        lineHeight: `${lineHeight}px`,
      });
      layer.append(span);
      cursor = line.end;
      y += lineHeight + 2;
    }
  };

  const compose = async () => {
    const root = document.querySelector("[data-sol-pretext-composition]");
    const layer = root?.querySelector(".character-sheet__flow");
    const image = root?.querySelector(".character-sheet__portrait img");
    if (!(root instanceof HTMLElement) || !(layer instanceof HTMLElement) || !(image instanceof HTMLImageElement)) return;

    if (root.clientWidth < 720) {
      layer.replaceChildren();
      root.removeAttribute("data-pretext-ready");
      return;
    }

    await image.decode();
    readAlphaHull(image);
    const rootRect = root.getBoundingClientRect();
    const imageRect = image.getBoundingClientRect();
    const cards = [...root.querySelectorAll(".dossier-card")].filter(
      (card): card is HTMLElement => card instanceof HTMLElement,
    );
    if (cards.length !== 4 || alphaRows.length === 0) return;

    layer.replaceChildren();
    const starts = [0.12, 0.46, 0.12, 0.5];
    const sides: FlowSide[] = ["left", "left", "right", "right"];
    cards.forEach((card, index) => {
      renderBlock(layer, card, sides[index], rootRect.height * starts[index], rootRect, imageRect);
    });
    root.setAttribute("data-pretext-ready", "");
  };

  let frame = 0;
  const scheduleCompose = () => {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(() => void compose());
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", scheduleCompose, { once: true });
  } else {
    scheduleCompose();
  }

  const composition = document.querySelector("[data-sol-pretext-composition]");
  if (composition) new ResizeObserver(scheduleCompose).observe(composition);
</script>
<style>
  .character-sheet {
    --sheet-ink: rgb(0 0 0 / 92%);
    --sheet-faint: rgb(0 0 0 / 56%);
    --sheet-line: rgb(0 0 0 / 24%);
    --sheet-accent: #8f1d22;
    --sheet-pad: clamp(0.7rem, 1.5vw, 1.15rem);
    color: var(--sheet-ink);

    position: relative;
    isolation: isolate;
    width: min(100%, 76rem);
    margin-inline: auto;
    padding: var(--sheet-pad);
    overflow: hidden;
    border: 0;
    background: rgb(249 249 249);
    box-shadow:
      0 1rem 3rem rgb(0 0 0 / 16%),
      0.28rem 0.34rem 0 rgb(0 0 0 / 8%);
  }

  .character-sheet__frame {
    position: absolute;
    z-index: 5;
    pointer-events: none;
  }

  .character-sheet__frame--outer {
    inset: 0;
    z-index: 6;
    --corner-track-size: 1.75rem;
    --corner-box-size: 1rem;
    display: grid;
    grid-template:
      "tl . tr" var(--corner-track-size)
      ".  .  ." 1fr
      "bl . br" var(--corner-track-size)
      / var(--corner-track-size) 1fr var(--corner-track-size);
    padding: 0;
  }

  .character-sheet__frame--outer::before,
  .character-sheet__frame--outer::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
  }

  .character-sheet__frame--outer::before {
    z-index: 10;
    background:
      linear-gradient(135deg, rgb(249 249 249) 0 48%, transparent 52%) top left / 0.8rem 0.8rem no-repeat,
      linear-gradient(225deg, rgb(249 249 249) 0 48%, transparent 52%) top right / 0.8rem 0.8rem no-repeat,
      linear-gradient(45deg, rgb(249 249 249) 0 48%, transparent 52%) bottom left / 0.8rem 0.8rem no-repeat,
      linear-gradient(315deg, rgb(249 249 249) 0 48%, transparent 52%) bottom right / 0.8rem 0.8rem no-repeat;
    filter:
      drop-shadow(0 0 0.045rem rgb(0 0 0 / 82%))
      drop-shadow(0.1rem 0.12rem 0.08rem rgb(0 0 0 / 65%));
  }

  .character-sheet__frame--outer::after {
    z-index: 5;
    border: 1px solid rgb(0 0 0 / 48%);
    clip-path: polygon(
      0 0.8rem,
      0.8rem 0,
      calc(100% - 0.8rem) 0,
      100% 0.8rem,
      100% calc(100% - 0.8rem),
      calc(100% - 0.8rem) 100%,
      0.8rem 100%,
      0 calc(100% - 0.8rem)
    );
  }

  .character-sheet__frame--inner {
    inset: 0.45rem;
    border: 1px solid rgb(0 0 0 / 22%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 72%),
      0 0 0.3rem 0.1rem rgb(0 0 0 / 44%);
  }

  .character-sheet__corner {
    display: flex;
    width: var(--corner-box-size);
    height: var(--corner-box-size);
    place-self: center;
    align-items: center;
    justify-content: center;
    background: rgb(249 249 249);
    color: rgb(0 0 0);
    font: 400 0.72rem / 1 var(--font_mono);
    box-shadow: 0.0625rem 0.0625rem 0 rgb(0 0 0 / 24%);
    transform: rotate3d(
      var(--corner-rotate-x, 0),
      var(--corner-rotate-y, 0),
      var(--corner-rotate-z, 1),
      var(--corner-rotate-angle, 0deg)
    );
    transform-style: preserve-3d;
  }

  .character-sheet__corner--tl {
    grid-area: tl;
  }

  .character-sheet__corner--tr {
    --corner-rotate-y: 1;
    --corner-rotate-z: 0;
    --corner-rotate-angle: 180deg;

    grid-area: tr;
  }

  .character-sheet__corner--bl {
    --corner-rotate-x: 1;
    --corner-rotate-z: 0;
    --corner-rotate-angle: 180deg;

    grid-area: bl;
  }

  .character-sheet__corner--br {
    --corner-rotate-angle: 180deg;

    grid-area: br;
  }

  .character-sheet::before,
  .character-sheet::after {
    position: absolute;
    z-index: -1;
    color: var(--sheet-faint);
    font: 700 clamp(3rem, 10vw, 8rem) / 0.8 sans-serif;
    letter-spacing: -0.08em;
    opacity: 0.07;
    content: "001";
  }

  .character-sheet::before {
    top: 18%;
    left: -0.04em;
  }

  .character-sheet::after {
    right: -0.03em;
    bottom: 13%;
    transform: rotate(90deg);
  }

  .character-sheet__masthead,
  .character-sheet__footer {
    position: relative;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .character-sheet__masthead {
    align-items: start;
    margin-inline: calc(var(--sheet-pad) * -1);
    padding: 0 var(--sheet-pad) 0.3rem;
    border-bottom: 1px solid var(--sheet-line);
  }

  .character-sheet__eyebrow,
  .dossier-card__number,
  .character-sheet__alias,
  .character-sheet__footer span,
  .character-sheet__portrait small {
    margin: 0;
    font: 400 var(--text_micro) / var(--leading_body) var(--font_mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .character-sheet h1 {
    margin: 0;
    font: 400 var(--text_h1) / var(--leading_display) var(--font_heading);
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .character-sheet__alias {
    margin-top: 0.15rem;
    color: var(--sheet-faint);
    font-weight: 300;
  }

  .character-sheet__mark {
    margin: 0.15rem 0 0;
    padding: 0.25rem 0.4rem;
    border: 1px solid var(--sheet-accent);
    color: var(--sheet-accent);
    font: 400 var(--text_micro) / 1 var(--font_mono);
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
    transform: rotate(4deg);
  }

  .character-sheet__body {
    --orbit-gap: clamp(0.6rem, 1.5vw, 1.25rem);

    position: relative;
    display: grid;
    grid-template-columns: minmax(13rem, 1fr) minmax(18rem, 0.9fr) minmax(13rem, 1fr);
    align-items: center;
    min-height: var(--pretext-spine-height, 48rem);
    container-type: inline-size;
  }

  .character-sheet__flow {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  :global(.pretext-float-heading),
  :global(.pretext-float-line) {
    position: absolute;
    display: block;
    color: var(--sheet-ink);
    white-space: pre;
  }

  :global(.pretext-float-heading) {
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--sheet-line);
    color: var(--sheet-faint);
    font: 400 var(--text_micro) / var(--leading_body) var(--font_mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  :global(.pretext-float-field) {
    position: absolute;
    display: grid;
    align-content: start;
    gap: 0.05rem;
    color: var(--sheet-ink);
  }

  :global(.pretext-float-field__label) {
    color: var(--sheet-faint);
    font: 300 var(--text_micro) / var(--leading_body) var(--font_mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.pretext-float-field__value) {
    font: 400 var(--text_fine) / var(--leading_body) var(--font_body);
  }

  .character-sheet__body[data-pretext-ready] > .character-sheet__column {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .character-sheet__column {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--orbit-gap);
  }

  .character-sheet__column--left {
    transform: translateX(0.55rem);
  }

  .character-sheet__column--right {
    transform: translateX(-0.55rem);
  }

  .dossier-card {
    padding: 0.35rem 0;
    border: 0;
    background: transparent;
  }

  .dossier-card__number {
    padding-bottom: 0.28rem;
    border-bottom: 1px solid var(--sheet-line);
    color: var(--sheet-faint);
  }

  .dossier-card dl,
  .dossier-card dd,
  .dossier-card blockquote,
  .dossier-card p {
    margin: 0;
  }

  .dossier-card dl > div {
    display: grid;
    grid-template-columns: 4.75rem 1fr;
    gap: 0.4rem;
    padding-block: 0.34rem;
    border-bottom: 1px solid rgb(0 0 0 / 10%);
  }

  .dossier-card dl > div:last-child {
    border-bottom: 0;
  }

  .dossier-card dt {
    color: var(--sheet-faint);
    font: 300 var(--text_micro) / var(--leading_body) var(--font_mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dossier-card dd {
    font-weight: 400;
  }

  .dossier-card blockquote {
    padding-top: 0.3rem;
    font-size: var(--text_body);
    font-weight: 300;
    font-style: italic;
    line-height: var(--leading_body);
  }

  .dossier-card--practice p:not(.dossier-card__number) {
    padding-top: 0.3rem;
    font-weight: 300;
    line-height: var(--leading_body);
  }

  .dossier-card ul {
    display: grid;
    gap: 0.22rem;
    margin: 0.42rem 0 0;
    padding: 0;
    list-style: none;
  }

  .dossier-card li::before {
    margin-right: 0.55rem;
    color: var(--sheet-accent);
    content: "■";
  }

  .dossier-card li {
    width: fit-content;
    padding-inline: 0.15rem;
    background: rgb(249 249 249);
    font-weight: 300;
  }

  .dossier-card--traits {
    margin-inline-start: 34%;
  }

  .pretext-flow-line {
    display: block;
    min-height: 1lh;
    padding-inline: 0.1rem;
    background: rgb(249 249 249);
    box-shadow: 0 0 0 1px rgb(249 249 249);
    white-space: pre;
  }

  .character-sheet__portrait {
    position: relative;
    z-index: 1;
    align-self: stretch;
    min-height: var(--pretext-spine-height, 48rem);
    margin: 0 -3rem;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .character-sheet__portrait img {
    width: auto;
    max-width: none;
    height: calc(var(--pretext-spine-height, 48rem) + 4rem);
    min-height: 0;
    object-fit: contain;
    object-position: center bottom;
    filter: grayscale(1) contrast(1.08);
  }

  .character-sheet__portrait figcaption {
    position: absolute;
    z-index: 2;
    right: 1.5rem;
    bottom: 2rem;
    display: grid;
    justify-items: end;
    color: white;
    text-shadow: 0 1px 0.8rem black;
  }

  .character-sheet__portrait figcaption span {
    font: 800 clamp(1.6rem, 4vw, 3rem) / 1 sans-serif;
    letter-spacing: -0.04em;
  }

  .character-sheet__footer {
    align-items: end;
    padding-top: 0.55rem;
    border-top: 1px solid var(--sheet-line);
    font: 600 0.78rem / 1.4 monospace;
  }

