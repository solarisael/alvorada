---
import { SiteLayout, with_base } from "../site/index.ts";

const profile = [
  ["Name", "Solarisael"],
  ["Callsign", "Sol"],
  ["Class", "Developer · Writer · Worldbuilder"],
  ["Experience", "Almost two decades"],
];

const traits = [
  "systems thinking",
  "strange software",
  "mythmaking",
  "black sheep persistence",
];

const portrait_sizes = "(max-width: 900px) 100vw, 1041px";
const portrait_srcset = (extension: "avif" | "webp") =>
  [520, 780, 1041]
    .map(
      (width) =>
        `${with_base(`images/solarisaeia_character_transparent_${width}.${extension}`)} ${width}w`,
    )
    .join(", ");
---

<SiteLayout page_title="About">
  <h1>Solarisael</h1>
  <p>Personal archive · specimen 001</p>
  <p>Known to friends as <strong>Sol</strong></p>
  <p>Still becoming</p>

  <h2>Identity</h2>
  <dl>
    {
      profile.map(([label, value]) => (
        <>
          <>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </>
        </>
      ))
    }
  </dl>

  <h2>Prime directive</h2>
  <blockquote>
    Change the world so fewer people feel the desperation I knew.
  </blockquote>

  <figure>
    <picture>
      <source
        type="image/avif"
        srcset={portrait_srcset("avif")}
        sizes={portrait_sizes}
      />
      <source
        type="image/webp"
        srcset={portrait_srcset("webp")}
        sizes={portrait_sizes}
      />
      <img
        src={with_base("images/solarisaeia_character_transparent.png")}
        alt="Solarisael, a black horned figure wrapped in a pale mantle"
        width="1041"
        height="934"
        sizes={portrait_sizes}
        loading="lazy"
        decoding="async"
      />
    </picture>
    <figcaption>
      <span>Solarisaeia</span>
      <small>the shape at the edge of the water</small>
    </figcaption>
  </figure>

  <h2>Practice</h2>
  <p>
    I build software, stories, and systems that make difficult things legible
    without sanding away their strangeness.
  </p>
  <p>
    Code has been part of my life for almost two decades. This site is where the
    technical work and the mythic work are finally allowed to belong to the same
    person.
  </p>

  <h2>Known traits</h2>
  <ul>{traits.map((trait) => <li>{trait}</li>)}</ul>

  <h2>Standing</h2>
  <p><strong>Alignment</strong> Ternary in a binary world</p>
  <p><strong>Current quest</strong> Build what should already exist</p>
  <p>Black sheep / black sun</p>
</SiteLayout>
