---
import IndexLayout from "../layouts/index.astro";
---

<IndexLayout page_title="About" phase="about" banner_title="About">
  <vessel data-shape="home_gate" id="sol_home_card_gate">
    <div id="sol_home_gate_intro">
      <div id="sol_home_gate_body">
        <p class="sol__home_intro_lead">
          Name’s <span
            class="sol__text_fx"
            data-text-fx="gradient aura"
            data-text-fx-gradient-intensity="0.7"
            data-text-fx-aura-intensity="0.6">Solarisael</span
          >, my friends call me <strong>Sol</strong> for short!
        </p>
        <p class="sol__home_intro_line">
          Since you’re a fren, call me <span
            class="sol__text_fx"
            data-text-fx="glow"
            data-text-fx-glow-intensity="0.75">Sol</span
          > too!
        </p>
        <p class="sol__home_intro_line">
          I am a developer of many many years, doing code for <span
            class="sol__text_fx"
            data-text-fx="etch"
            data-text-fx-etch-intensity="0.7">almost 2 decades</span
          > by now.
        </p>
      </div>
    </div>
  </vessel>
</IndexLayout>
