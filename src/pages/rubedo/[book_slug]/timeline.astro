---
// Timeline constellation page — single page per book, no sub-routes.
// The constellation fetches /rubedo/data/:book_slug.json on load and
// caches it in a module-scoped object. Hover preview reads from that cache.
// No server roundtrip on hover. No static pages per timeline state.
//
// FUTURE: chapter nodes should reflect codex unlock state —
// locked nodes render dimmed or with a locked sigil variant.
// This requires passing session state to the constellation init.

import IndexLayout from "../../../layouts/index.astro";
import ContentLink from "../../../components/page/content_link.astro";
import TimelineInteractive from "../../../components/rubedo/timeline_interactive.astro";
import {
  rubedo_book_map,
  rubedo_book_slugs,
  derive_chapter_slug,
} from "../../../data/rubedo/book_timeline_runtime.js";
import { with_base } from "../../../utils/routes.js";

export const getStaticPaths = () => {
  return rubedo_book_slugs.map((book_slug) => {
    return { params: { book_slug } };
  });
};

const { book_slug } = Astro.params;

const book_entry = rubedo_book_map[book_slug] ?? null;

// JSON endpoint the constellation will fetch on load.
const timeline_data_href = with_base(`/rubedo/data/${book_slug}.json`);

// Canonical first chapter — used as entry point from this page.
// Spread before sort — book_entry.chapters is frozen.
const first_chapter =
  [...(book_entry?.chapters ?? [])].sort(
    (left_chapter, right_chapter) =>
      left_chapter.timeline_position - right_chapter.timeline_position,
  )[0] ?? null;

const reader_entry_href = first_chapter
  ? with_base(
      `/rubedo/${book_slug}/${derive_chapter_slug(first_chapter.timeline_position)}`,
    )
  : with_base(`/rubedo/${book_slug}`);

const rubedo_index_href = with_base("/rubedo");

const crumb_label_overrides = {
  timeline: "constellation",
};
---

<IndexLayout
  body_class="sol__pov_cinza"
  crumb_label_overrides={crumb_label_overrides}
>
  <rubedo data-shape="timeline_page" class="sol__rubedo_timeline_page">
    <div class="sol__rubedo_timeline_header">
      <h1>{book_entry?.title ?? "Rubedo Book"} — constellation</h1>
    </div>

    {book_entry?.synopsis && <p>{book_entry.synopsis}</p>}

    {
      !book_entry && (
        <p>
          Unknown book slug <code>{book_slug}</code>. Return to the Rubedo
          index.
        </p>
      )
    }

    <p>
      <ContentLink href={rubedo_index_href}> Back to Rubedo index </ContentLink>
    </p>

    {
      book_entry && (
        <p>
          <ContentLink href={reader_entry_href}>
            Begin reading {book_entry.title}
          </ContentLink>
        </p>
      )
    }

    {
      book_entry && (
        <TimelineInteractive
          book_slug={book_slug}
          timeline_data_href={timeline_data_href}
        />
      )
    }
  </rubedo>
</IndexLayout>
