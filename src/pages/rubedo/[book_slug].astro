---
import IndexLayout from "../../layouts/index.astro";
import {
  rubedo_book_map,
  rubedo_book_slugs,
  derive_chapter_slug,
} from "../../data/rubedo/book_timeline_runtime.js";

export const getStaticPaths = () => {
  return rubedo_book_slugs.map((book_slug) => {
    return { params: { book_slug } };
  });
};

const { book_slug } = Astro.params;

const base_url = import.meta.env.BASE_URL;
const base_path = base_url.replace(/\/+$/, "");
const with_base = (path_value) => {
  const normalized_path = String(path_value).replace(/^\/+/, "");
  return `${base_path}/${normalized_path}`;
};

const book_entry = rubedo_book_map[book_slug] ?? null;

const sorted_chapters = [...(book_entry?.chapters ?? [])].sort(
  (left_chapter, right_chapter) =>
    left_chapter.timeline_position - right_chapter.timeline_position,
);

const first_chapter = sorted_chapters[0] ?? null;

const canonical_reader_href = first_chapter
  ? with_base(
      `/rubedo/${book_slug}/${derive_chapter_slug(first_chapter.timeline_position)}`,
    )
  : with_base("/rubedo");

const timeline_href = with_base(`/rubedo/${book_slug}/timeline`);
const rubedo_index_href = with_base("/rubedo");
---

<IndexLayout body_class="pov_cinza">
  <rubedo data-shape="book_page">
    <div class="book-header">
      <h1>{book_entry?.title ?? "Rubedo Book"}</h1>
    </div>

    {
      book_entry ? (
        <p>{book_entry.synopsis}</p>
      ) : (
        <p>
          Unknown book slug <code>{book_slug}</code>. Return to Rubedo index.
        </p>
      )
    }

    <p>
      <a
        href={rubedo_index_href}
        hx-get={rubedo_index_href}
        hx-target="#content"
        hx-select="#content"
        hx-swap="morph swap:240ms settle:240ms"
        hx-push-url="true"
      >
        Back to Rubedo index
      </a>
    </p>

    {
      book_entry && (
        <>
          <p>
            <a
              href={canonical_reader_href}
              hx-get={canonical_reader_href}
              hx-target="#content"
              hx-select="#content"
              hx-swap="morph swap:240ms settle:240ms"
              hx-push-url="true"
            >
              Begin reading {book_entry.title}
            </a>
          </p>
          <p>
            <a
              href={timeline_href}
              hx-get={timeline_href}
              hx-target="#content"
              hx-select="#content"
              hx-swap="morph swap:240ms settle:240ms"
              hx-push-url="true"
            >
              Open constellation timeline
            </a>
          </p>
        </>
      )
    }
  </rubedo>
</IndexLayout>
