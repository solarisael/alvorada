---
import { getCollection, render } from "astro:content";
import IndexLayout from "../../layouts/index.astro";

export async function getStaticPaths() {
  const entries = await getCollection("citrinitas", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { post_slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const base_path = import.meta.env.BASE_URL.replace(/\/+$/, "");
const display_title = entry.data.title ?? entry.data.slug;
---

<IndexLayout
  phase="citrinitas"
  crumbs={[
    { label: "home", href: `${base_path}/` },
    { label: "citrinitas", href: `${base_path}/citrinitas` },
    { label: display_title, href: null },
  ]}
>
  <citrinitas data-shape="entry_detail">
    <div class="sol__entry_header">
      <time datetime={entry.data.published_at} class="sol__text_kicker">
        {entry.data.published_at}
      </time>
      <h1>{display_title}</h1>
    </div>

    <div class="sol__entry_body sol__chapter_content">
      <Content />
    </div>
  </citrinitas>
</IndexLayout>
