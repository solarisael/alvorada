---
import { getCollection, render } from "astro:content";
import IndexLayout from "../../layouts/index.astro";
import EntryDetail from "../../components/page/entry_detail.astro";
import { with_base } from "../../utils/routes.js";

export async function getStaticPaths() {
  const entries = await getCollection("citrinitas", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { post_slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const display_title = entry.data.title ?? entry.data.slug;
---

<IndexLayout
  phase="citrinitas"
  crumbs={[
    { label: "home", href: with_base("/") },
    { label: "citrinitas", href: with_base("/citrinitas") },
    { label: display_title, href: null },
  ]}
>
  <citrinitas data-shape="entry_detail">
    <EntryDetail title={display_title} published_at={entry.data.published_at}>
      <Content />
    </EntryDetail>
  </citrinitas>
</IndexLayout>
