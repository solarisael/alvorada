---
import IndexLayout from "../../layouts/index.astro";

export const getStaticPaths = () => {
  return [
    { params: { post_slug: "sun-archive" } },
    { params: { post_slug: "golden-fragments" } },
    { params: { post_slug: "glass-garden" } },
  ];
};

const post_slug = Astro.params.post_slug ?? "unknown-post";
const base_url = import.meta.env.BASE_URL;
const base_path = base_url.replace(/\/+$/, "");
const with_base = (path_value) => {
  const normalized_path = String(path_value).replace(/^\/+/, "");

  return `${base_path}/${normalized_path}`;
};
---

<IndexLayout>
  <citrinitas data-shape="entry_detail">
    <div class="sol__entry_header">
      <p>~/ citrinitas / {post_slug}</p>
      <h1>Citrinitas Post</h1>
    </div>

    <div class="sol__entry_body">
      <p>
        Scaffold child page for <code>/citrinitas/{post_slug}</code>. Use this
        to verify nested breadcrumbs and HTMX transitions.
      </p>
      <p>
        <a
          href={with_base("/citrinitas")}
          hx-get={with_base("/citrinitas")}
          hx-target="#sol_content"
          hx-select="#sol_content"
          hx-swap="morph swap:240ms settle:240ms"
          hx-push-url="true">Back to Citrinitas index</a
        >
      </p>
    </div>
  </citrinitas>
</IndexLayout>
