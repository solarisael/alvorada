---
import IndexLayout from "../../layouts/index.astro";
import ContentLink from "../../components/page/content_link.astro";
import {
  citrinitas_book_map,
  citrinitas_book_slugs,
} from "../../data/citrinitas/booklet_runtime.js";
import { citrinitas_chapter_path } from "../../data/citrinitas/route_data.js";
import { build_crumbs, with_base } from "../../utils/routes.js";

export const getStaticPaths = () =>
  citrinitas_book_slugs.map((book_slug) => ({ params: { book_slug } }));

const { book_slug } = Astro.params;
const book = citrinitas_book_map[book_slug] ?? null;

const display_title = book?.title ?? book_slug;
const cover_src = book?.cover ? with_base(book.cover) : null;
const chapters = (book?.chapters ?? []).map((chapter) => ({
  ...chapter,
  href: with_base(
    citrinitas_chapter_path(book_slug, chapter.chapter_slug),
  ),
}));
---

<IndexLayout
  page_title={display_title}
  phase="citrinitas"
  crumbs={build_crumbs([
    { label: "citrinitas", href: with_base("/citrinitas") },
    { label: display_title, href: null },
  ])}
>
  <citrinitas data-shape="booklet_page" class="sol__citrinitas_booklet">
    <div class="sol__citrinitas_booklet_header">
      {cover_src && (
        <img
          class="sol__citrinitas_booklet_cover"
          src={cover_src}
          alt=""
          loading="eager"
          decoding="async"
        />
      )}
      <div class="sol__citrinitas_booklet_meta">
        <h1 class="sol__citrinitas_booklet_title">{display_title}</h1>
        {book?.synopsis && (
          <p class="sol__citrinitas_booklet_synopsis">{book.synopsis}</p>
        )}
      </div>
    </div>

    {
      chapters.length === 0 ? (
        <p class="sol__citrinitas_empty">This booklet has no pieces yet.</p>
      ) : (
        <ol class="sol__citrinitas_chapter_list">
          {chapters.map((chapter, index) => (
            <li class="sol__citrinitas_chapter_row">
              <ContentLink href={chapter.href} class="sol__citrinitas_chapter_link">
                <span class="sol__citrinitas_chapter_index sol__text_kicker">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="sol__citrinitas_chapter_title">{chapter.title}</span>
                {chapter.excerpt && (
                  <span class="sol__citrinitas_chapter_excerpt">
                    {chapter.excerpt}
                  </span>
                )}
              </ContentLink>
            </li>
          ))}
        </ol>
      )
    }
  </citrinitas>
</IndexLayout>