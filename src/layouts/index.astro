---
import { Image } from "astro:assets";
import "../styles/base.css";
import "../styles/index.css";
import "../styles/components/content-shell.css";
import "../styles/components/footer.css";
import "../styles/components/rubedo-timeline.css";

import Breadcrumbers from "../components/breadcrumbers.astro";
import MobileNavbar from "../components/mobile_navbar.astro";
import Navbar from "../components/navbar.astro";
import StyleSwitcher from "../components/style_switcher.astro";

const { body_class = "" } = Astro.props;
const base_url = import.meta.env.BASE_URL;
const base_path = base_url.replace(/\/+$/, "");
const with_base = (path_value) => {
  const normalized_path = String(path_value).replace(/^\/+/, "");

  return `${base_path}/${normalized_path}`;
};
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const normalized_pathname = pathname.startsWith(base_path)
  ? pathname.slice(base_path.length) || "/"
  : pathname;
const auto_body_classes = [];

if (
  normalized_pathname === "/rubedo" ||
  normalized_pathname.startsWith("/rubedo/")
) {
  auto_body_classes.push("route_rubedo");
}

const manual_body_classes = String(body_class).split(/\s+/).filter(Boolean);

const resolved_body_classes = Array.from(
  new Set([
    "body_grid",
    "compound_body_grid",
    "page-transition-breath-noticeable",
    ...auto_body_classes,
    ...manual_body_classes,
  ]),
);
---

<!doctype html>
<html
  lang="en"
  data-site-theme="cinza"
  data-site-shell="medium"
  data-site-fx="balanced"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Sol's Rest</title>
    <link rel="shortcut icon" href="favicon.ico" type="image/x-icon" />

    <script src={with_base("js/vendor/htmx_runtime.js")} type="module"></script>
    <script src={with_base("js/vendor/idiomorph-ext.js")}></script>
    <script src={with_base("js/scripts.js")} type="module"></script>
  </head>
  <body
    class:list={resolved_body_classes}
    hx-boost="true"
    hx-ext="morph,head-support,preload,sse"
    hx-target="#content"
    hx-select="#content"
    hx-select-oob="#content"
    hx-swap="morph swap:240ms settle:240ms"
    hx-push-url="true"
  >
    <Navbar />
    <MobileNavbar />
    <container>
      <main id="page-main">
        <div id="content_stage">
          <div class="content-stage-layer content-stage-layer-fog"></div>
          <div class="content-stage-layer content-stage-layer-rails"></div>

          <div id="content_fog_backdrop">
            <div class="content-fog-layer content-fog-layer-top"></div>
            <div class="content-fog-layer content-fog-layer-bottom"></div>
          </div>

          <div id="content">
            <div class="content-layer content-layer-surface"></div>
            <div class="content-layer content-layer-noise"></div>
            <div class="content-layer content-layer-deco"></div>
            <div class="content-layer content-layer-ornament-svg">
              <img
                class="content-ornament content-ornament-corner-tl"
                src={with_base("ornaments/cinza/frame_corner_tl.svg")}
                alt=""
                loading="eager"
                decoding="async"
              />
              <img
                class="content-ornament content-ornament-corner-tr"
                src={with_base("ornaments/cinza/frame_corner_tr.svg")}
                alt=""
                loading="eager"
                decoding="async"
              />
              <img
                class="content-ornament content-ornament-corner-bl"
                src={with_base("ornaments/cinza/frame_corner_bl.svg")}
                alt=""
                loading="eager"
                decoding="async"
              />
              <img
                class="content-ornament content-ornament-corner-br"
                src={with_base("ornaments/cinza/frame_corner_br.svg")}
                alt=""
                loading="eager"
                decoding="async"
              />
              <img
                class="content-ornament content-ornament-line-top"
                src={with_base("ornaments/cinza/frame_line_top.svg")}
                alt=""
                loading="eager"
                decoding="async"
              />
              <img
                class="content-ornament content-ornament-line-bottom"
                src={with_base("ornaments/cinza/frame_line_bottom.svg")}
                alt=""
                loading="eager"
                decoding="async"
              />
              <img
                class="content-ornament content-ornament-sigil-top"
                src={with_base("ornaments/cinza/sigil_moon_star.svg")}
                alt=""
                loading="eager"
                decoding="async"
              />
              <img
                class="content-ornament content-ornament-sigil-bottom"
                src={with_base("ornaments/cinza/sigil_eye.svg")}
                alt=""
                loading="eager"
                decoding="async"
              />
            </div>

            <div class="content-layer-body">
              <div id="main_reading_container">
                <div class="reading-layer reading-layer-surface"></div>
                <div class="reading-layer reading-layer-noise"></div>

                <div class="reading-layer-body">
                  <Breadcrumbers />
                  <slot />
                </div>
              </div>

              <div id="content_footer_lane">
                <slot name="footer">
                  <footer id="footer">
                    <a href=""
                      >Made with pure hatred <br />
                      You should all die</a
                    >
                  </footer>
                </slot>
              </div>
            </div>
          </div>
        </div>
        <StyleSwitcher />
      </main>
    </container>
  </body>
</html>
