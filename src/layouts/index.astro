---
import { Image } from "astro:assets";
import "../styles/base.css";
import "../styles/index.css";
import "../styles/components/content_shell.css";
import "../styles/components/footer.css";
import "../styles/components/rubedo_timeline.css";
// Page-specific CSS hoisted to layout level so htmx-nav has it available.
// Astro page-scoped imports only inject on native page load; htmx swaps don't
// pull the response's <style> tags, so cards/entries render unstyled. Keep these
// here unless head-support extension starts merging style tags reliably.
import "../styles/components/home_card_gate.css";
import "../styles/components/nigredo_page.css";
import "../styles/components/albedo_page.css";
import "../styles/components/citrinitas_page.css";
import "../styles/components/wikilink.css";
import "../styles/components/pretext_justify.css";
import "../styles/components/vision_banner.css";

import Breadcrumbers from "../components/mantle/breadcrumbs.astro";
import MobileNavbar from "../components/mantle/mobile_navbar.astro";
import Navbar from "../components/mantle/desktop_navbar.astro";
import SideMenu from "../components/mantle/side_menu.astro";
import Footer from "../components/mantle/footer.astro";
import Fog from "../components/aether/fog.astro";
import ContentFrame from "../components/ornament/content_frame.astro";
import VisionBanner from "../components/page/vision_banner.astro";
import { base_path, with_base } from "../utils/routes.js";

const {
  body_class = "",
  phase: phase_prop = "",
  frontmatter = {},
  crumb_label_overrides = {},
  crumbs = null,
  theme_color = null,
  page_title = "",
  hide_breadcrumbs = false,
  banner_title = "",
  banner_kicker = "",
  banner_description = "",
  banner_image_path = "images/solarisaeia_sea_render_3_farther.png",
} = Astro.props;
const phase = phase_prop || frontmatter.phase || "";
const body_phase = phase || "home";
const resolved_page_title = page_title || frontmatter.title || "Sol's Rest";
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const normalized_pathname = pathname.startsWith(base_path)
  ? pathname.slice(base_path.length) || "/"
  : pathname;
const manual_body_classes = String(body_class).split(/\s+/).filter(Boolean);

const resolved_body_classes = Array.from(
  new Set([
    "sol__body_grid",
    "sol__compound_body_grid",
    "sol__page_transition_breath_noticeable",
    ...manual_body_classes,
  ]),
);
---

<!doctype html>
<html
  lang="en"
  data-site-theme="solarisael"
  data-site-shell="medium"
  data-site-fx="balanced"
  data-site-scale="100"
  data-base-path={base_path}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{resolved_page_title}</title>
    <link
      rel="icon"
      href={with_base("images/small_render_4.png")}
      type="image/png"
    />

    {
      /*
      LOAD-BEARING — DO NOT TOUCH.

      htmx (UMD build, self-assigns window.htmx) and idiomorph-ext (uses window.htmx)
      MUST load as plain synchronous scripts in this exact order. Do NOT add `type="module"`,
      do NOT add `defer` or `async`, do NOT reorder. Module + plain mix or any deferral
      causes a load-order race where idiomorph-ext fires before htmx is defined and the
      whole site's swap behavior breaks ("htmx is not defined" in console).

      scripts.js stays a module — it's user code and is allowed to defer.
    */
    }
    <script is:inline src={with_base("js/vendor/htmx.min.js")}></script>
    <script is:inline src={with_base("js/vendor/idiomorph-ext.js")}></script>
    <script is:inline src={with_base("js/vendor/htmx-preload-ext.js")}></script>
    <script src={with_base("js/scripts.js")} type="module"></script>
    <script>
      import "../scripts/pretext_justify.js";
      import "../scripts/shader_chalice_lab.js";
      import "../scripts/vision_banner.js";
    </script>
  </head>
  <body
    class:list={resolved_body_classes}
    data-phase={body_phase}
    hx-ext="morph,head-support,preload,sse"
    hx-target="#sol_page_shell"
    hx-select="#sol_page_shell"
    hx-swap="morph:outerHTML swap:220ms settle:260ms"
    hx-push-url="true"
  >
    <Navbar />
    <MobileNavbar />
    <main id="sol_page_shell">
      {
        banner_title && (
          <VisionBanner
            title={banner_title}
            kicker={banner_kicker}
            description={banner_description}
            image_path={banner_image_path}
          />
        )
      }
      <container data-phase={phase || undefined}>
        <vessel data-shape="page_main" id="sol_page_main">
          <div id="sol_content_stage">
            <div class="sol__content_stage_layer sol__content_stage_layer_fog">
            </div>
            <div
              class="sol__content_stage_layer sol__content_stage_layer_rails"
            >
            </div>

            <Fog />

            <div id="sol_content">
              <div class="sol__content_layer sol__content_layer_surface"></div>
              <div class="sol__content_layer sol__content_layer_noise"></div>
              <div class="sol__content_layer sol__content_layer_deco"></div>

              <ContentFrame />

              <div class="sol__content_layer_body">
                <div id="sol_main_reading_container">
                  <div class="sol__reading_layer sol__reading_layer_surface">
                  </div>
                  <div class="sol__reading_layer sol__reading_layer_noise">
                  </div>

                  <div class="sol__reading_layer_body">
                    {
                      !hide_breadcrumbs && (
                        <Breadcrumbers
                          crumbs={crumbs}
                          crumb_label_overrides={crumb_label_overrides}
                          theme_color={theme_color}
                        />
                      )
                    }
                    <slot />
                  </div>
                </div>

                <div id="sol_content_footer_lane">
                  <slot name="footer">
                    <Footer phase={phase} />
                  </slot>
                </div>
              </div>
            </div>
          </div>
          <SideMenu />
        </vessel>
      </container>
    </main>
  </body>
</html>
