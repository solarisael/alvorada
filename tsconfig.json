{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "types": [
      "bun"
    ],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
